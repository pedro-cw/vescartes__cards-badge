<script>
  (() => {
    const selector = '[data-cart-size-selector]';

    const refreshCartDrawer = () => {
      document.dispatchEvent(new CustomEvent('cart:change', {
        bubbles: true,
        detail: {
          source: 'cart-drawer-size-selector'
        }
      }));

      document.dispatchEvent(new CustomEvent('cart:refresh', {
        bubbles: true
      }));
    };

    document.addEventListener('change', async (event) => {
      const select = event.target.closest(selector);

      if (!select || select.disabled) return;

      const currentVariantId = String(select.dataset.currentVariantId || '');
      const selectedVariantId = String(select.value || '');

      if (!selectedVariantId || selectedVariantId === currentVariantId) return;

      select.disabled = true;

      try {
        const addResponse = await fetch(`${window.Shopify.routes.root}cart/add.js`, {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json'
          },
          body: JSON.stringify({
            items: [{
              id: Number(selectedVariantId),
              quantity: Number(select.dataset.quantity || 1)
            }]
          })
        });

        if (!addResponse.ok) {
          throw new Error('Unable to add selected size.');
        }

        const removeResponse = await fetch(`${window.Shopify.routes.root}cart/change.js`, {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json'
          },
          body: JSON.stringify({
            id: select.dataset.lineKey,
            quantity: 0
          })
        });

        if (!removeResponse.ok) {
          throw new Error('Unable to remove previous size.');
        }

        refreshCartDrawer();
      } catch (error) {
        select.value = currentVariantId;
        select.disabled = false;
      }
    });
  })();
</script>

