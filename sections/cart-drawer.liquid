              </svg>
              <span>Duties + Tarrifs included</span>
          </div>
          <div class="Drawer__USP">
              <svg width="19" height="18" viewBox="0 0 18.9 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M16.2,10.6s-4.3.9-7,.6-3.9-1-4.1-1.1c0,.2,0,1,0,1h0c-.7,0-1.6,0-2.6,0s-1.9-.4-1.9-.4c0,0,0-1.7.2-3s.6-2.3.7-2.4h0c.2,0,1.4.4,2,.6s2.1.6,5.3,1.6h0c-.1,0-.3-.3-.4-.6-.1-.5,0-.8.1-1,.3.2,2.9,1.6,3.6,1.9,1.2.4,2.9.8,3.3.9s.6.2.7.4.1,1.5.1,1.5Z" fill="#000" stroke-width="0"></path>
                <g>
                    <path d="M4.5,3.3c.2-.2,2.9-2.8,6.5-2.3,3.8.5,7.5,4.1,7,8.8-.5,4.3-4.4,7.5-8.8,7-1.7-.2-3.3-1-4.5-2.1" fill="none" stroke="#000" stroke-linecap="round" stroke-miterlimit="10" stroke-width="1.2"></path>
                    <polygon points="2.6 16.9 7.5 13 3.1 12.5 2.6 16.9" fill="#000" stroke-width="0"></polygon>
                </g>
              </svg>
              Easy Returns + Exchanges
          </div>
        </div>
      </div>
    </form>
  {%- endif -%}
</cart-drawer>

<script>
  window.freeShippingThreshold = {{ section.settings.free_shipping_threshold }};
</script>




<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  cart-drawer [slot="header"] {
    width: 100% !important;
  }

  .cart-title-items-count[slot="header"] {
    width: 100% !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) auto !important;
    grid-template-rows: auto auto !important;
    column-gap: 16px !important;
    row-gap: 18px !important;
    align-items: center !important;
    color: #242424 !important;
    font-family: "URW DIN", Arial, sans-serif !important;
    font-size: 28px !important;
    font-weight: 400 !important;
    line-height: 1 !important;
    text-transform: none !important;
    letter-spacing: normal !important;
  }

  .vescartes-cart-title-text {
    grid-column: 1 !important;
    grid-row: 1 !important;
    min-width: 0 !important;
    white-space: nowrap !important;
  }

  .cart-items-count {
    grid-column: 2 !important;
    grid-row: 1 !important;
    margin: 0 !important;
    color: #313131 !important;
    font-family: "URW DIN", Arial, sans-serif !important;
    font-size: 13px !important;
    font-weight: 400 !important;
    line-height: 15.6px !important;
    white-space: nowrap !important;
  }

  .vescartes-header-progress {
    grid-column: 1 / -1 !important;
    grid-row: 2 !important;
    width: 100% !important;
    margin: 0 auto !important;
    display: block !important;
  }

  .vescartes-header-progress .text-subdued {
    display: block !important;
    margin: 0 0 8px !important;
    color: #313131 !important;
    font-family: "URW DIN", Arial, sans-serif !important;
    font-size: 13px !important;
    font-weight: 400 !important;
    line-height: 15.6px !important;
    text-align: left !important;
  }

  .vescartes-header-progress .free-shipping-bar__progress {
    width: 100% !important;
    height: 4px !important;
    margin: 0 !important;
    border-radius: 4px !important;
    overflow: hidden !important;
    background: #E5E5E5 !important;
  }

  .vescartes-header-progress .free-shipping-bar__fill {
    height: 100% !important;
    background: #730101 !important;
  }

  .cart-drawer__items {
    gap: 0 !important;
    padding-block-start: 0 !important;
  }

  line-item.line-item {
    width: 100% !important;
    min-height: 98px !important;
    margin: 0 !important;
    padding: 6px 25px 5px 7px !important;
    display: grid !important;
    grid-template-columns: 82px minmax(0, 1fr) !important;
    column-gap: 20px !important;
    align-items: start !important;
    position: relative !important;
    overflow: hidden !important;
  }

  line-item.line-item > img.line-item__media {
    grid-column: 1 !important;
    width: 82px !important;
    height: 87px !important;
    min-width: 82px !important;
    max-width: 82px !important;
    margin: 0 !important;
    padding: 0 !important;
    display: block !important;
    object-fit: cover !important;
  }

  line-item.line-item > .line-item-info {
    grid-column: 2 !important;
    min-width: 0 !important;
    width: 100% !important;
    margin: 10px 0 0 !important;
    padding: 0 !important;
  }

  line-item.line-item > .line-item-info > .v-stack {
    width: 100% !important;
    min-width: 0 !important;
    display: grid !important;
    grid-template-columns: minmax(0, 134px) 47px !important;
    grid-template-rows: auto auto 25px !important;
    column-gap: 40px !important;
    align-items: start !important;
    position: relative !important;
    bottom: 5px !important;
  }

  line-item.line-item .title-price {
    display: contents !important;
  }

  line-item.line-item .title-price > a {
    grid-column: 1 !important;
    grid-row: 1 !important;
    width: 134px !important;
    max-width: 134px !important;
    min-width: 0 !important;
    margin: 0 !important;
    color: #313131 !important;
    font-family: "URW DIN", Arial, sans-serif !important;
