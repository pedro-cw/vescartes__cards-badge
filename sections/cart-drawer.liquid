<cart-drawer id="cart-drawer" class="cart-drawer drawer {% if cart.empty? %}drawer--center-body{% endif %} color-scheme color-scheme--{{ section.settings.color_scheme.id }}" initial-focus="false" handle-editor-events>
  <div class="h4 cart-title-items-count" slot="header">
    <span class="vescartes-cart-title-text">{{ 'cart.general.title' | t }}</span>
    <span class="cart-items-count">{{ cart.item_count }} items</span>

    {%- if section.settings.enable_fs and cart.empty? == false -%}
      <div class="vescartes-header-progress">
        {%- render 'free-shipping-bar' -%}
      </div>
    {%- endif -%}
  </div>

  {%- if cart.empty? -%}
    <p class="h5 text-center">{{ 'cart.general.empty' | t }}</p>
  {%- else -%}


    

    <div class="cart-drawer__items" {{ section.settings.uk_shipping }} >
      {%- for line_item in cart.items -%}
        <div class="vescartes-line-item-shell">
          {%- render 'line-item', line_item: line_item, show_quantity_selector: true -%}

          {%- unless line_item.variant.title == 'Default Title' -%}
            {%- liquid
              assign size_option_index = nil

              for option_name in line_item.product.options
                assign normalized_option_name = option_name | downcase

                if normalized_option_name == 'size'
                  assign size_option_index = forloop.index0
                  break
                endif
              endfor
            -%}

            {%- if size_option_index != nil -%}
              <div class="vescartes-cart-item-size">
                <label
                  class="vescartes-cart-item-size__label"
                  for="CartDrawerSize-{{ line_item.key | handle }}"
                >
                  Size:
                </label>

                <select
                  id="CartDrawerSize-{{ line_item.key | handle }}"
                  class="vescartes-cart-item-size__select"
                  data-cart-size-selector
                  data-line-key="{{ line_item.key }}"
                  data-current-variant-id="{{ line_item.variant_id }}"
                  data-quantity="{{ line_item.quantity }}"
                  aria-label="Select size for {{ line_item.product.title | escape }}"
                >
                  {%- for variant in line_item.product.variants -%}
                    {%- liquid
                      assign variant_matches = true

                      for option_value in line_item.options_with_values
                        assign option_index = forloop.index0

                        if option_index != size_option_index
                          case option_index
                            when 0
                              unless variant.option1 == option_value.value
                                assign variant_matches = false
                              endunless
                            when 1
                              unless variant.option2 == option_value.value
                                assign variant_matches = false
                              endunless
                            when 2
                              unless variant.option3 == option_value.value
                                assign variant_matches = false
                              endunless
                          endcase
                        endif
                      endfor
                    -%}

                    {%- if variant_matches -%}
                      {%- case size_option_index -%}
                        {%- when 0 -%}
                          {%- assign size_value = variant.option1 -%}
                        {%- when 1 -%}
                          {%- assign size_value = variant.option2 -%}
                        {%- when 2 -%}
                          {%- assign size_value = variant.option3 -%}
                      {%- endcase -%}

                      <option
                        value="{{ variant.id }}"
                        {% if variant.id == line_item.variant_id %}selected{% endif %}
                        {% unless variant.available %}disabled{% endunless %}
                      >
                        {{- size_value -}}
                      </option>
                    {%- endif -%}
                  {%- endfor -%}
                </select>
              </div>
            {%- endif -%}
          {%- endunless -%}
        </div>
      {%- endfor -%}
    </div>

    

    
    

    <form action="{{ routes.cart_url }}" method="POST" class="cart-drawer__footer" slot="footer">

      {%- liquid
        assign pair_with_handles = 'mexico-jersey,solace-denim,spain-jersey,lily-fang-denim,heavens-eclipse-denim,blossom-denim' | split: ','
        assign pair_with_products_count = 0

        for handle in pair_with_handles
          assign pair_product = all_products[handle]
          assign products_in_cart = cart.items | where: 'product_id', pair_product.id

          if pair_product != blank and pair_product.available and products_in_cart.size == 0
            assign pair_with_products_count = pair_with_products_count | plus: 1
          endif
        endfor
      -%}

      {%- if pair_with_products_count > 0 -%}
        <div class="cart-drawer__complementary-products complementary-products">
          <div class="complementary-products__header complementary-products__header--align-start">
            <p class="h6">PAIR WITH</p>
          </div>

          <div class="complementary-products__product-list complementary-products__product-list--carousel scroll-area snap-x">
            {%- for handle in pair_with_handles -%}
              {%- liquid
                assign pair_product = all_products[handle]
                assign products_in_cart = cart.items | where: 'product_id', pair_product.id
              -%}

              {%- if pair_product != blank and pair_product.available and products_in_cart.size == 0 -%}
                {%- render 'product-card-horizontal', product: pair_product, show_quick_buy: true -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

    <div class="subtotal-free-bar">
        <div class="subtotal-wrapper">
          <span class="label">Total :</span>
          <span class="cart-subtotal">{{ cart.total_price | money }}</span>
        </div>
          
      </div>
      {%- if section.settings.show_cart_note or section.settings.show_shipping_text -%}
        <div class="v-stack gap-0.5 justify-items-start shipping-cart-note">
          {%- if section.settings.show_cart_note -%}
            {%- assign cart_note_dialog_id = 'cart-note-' | append: section.id -%}
            <button class="link-faded-reverse" aria-controls="{{ cart_note_dialog_id }}">{{ 'cart.general.add_order_note' | t }}</button>

            <cart-note-dialog id="{{ cart_note_dialog_id }}" class="cart-drawer__order-note">
              <div class="form">
                <cart-note class="form-control">
                  {%- assign order_note = 'cart.general.order_note' | t -%}
                  {%- assign placeholder = 'cart.general.note_placeholder' | t -%}
                  {%- render 'input', name: 'note', multiline: 3, label: order_note, value: cart.note, placeholder: placeholder, show_label_as_block: true -%}
                </cart-note>

                <button type="button" class="button cart--close" is="dialog-close-button">{{ 'cart.general.save_note' | t }}</button>
              </div>
            </cart-note-dialog>
          {%- endif -%}

          {%- if section.settings.show_shipping_text -%}
            <p class="text-subdued">{{ 'cart.general.taxes_and_shipping_at_checkout' | t }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
      

      <input type="hidden" name="attributes[products_mobile_grid_mode]" value="">
      <input type="hidden" name="attributes[products_desktop_grid_mode]" value="">

      

      

      {% for discount_application in cart.cart_level_discount_applications %}
        <div class="h-stack justify-start gap-4 discounts-wrapper">
          <span class="discount-badge text-xs">{%- render 'icon' with 'discount', width: 12 -%} {{- discount_application.title -}}</span>
          <span class="text-subdued">-{{ discount_application.total_allocated_amount | money }}</span>
        </div>
      {% endfor %}

      <div class="button-group">
        {%- if section.settings.show_view_cart_button or section.settings.show_checkout_button == false -%}
          {%- assign view_cart = 'cart.general.view_cart' | t -%}
          {%- render 'button', href: routes.cart_url, content: view_cart, stretch: true -%}
        {%- endif -%}

        {%- if section.settings.show_checkout_button -%}
          {%- capture checkout_button -%}
            <svg xmlns="http://www.w3.org/2000/svg" width="18px" height="18px" viewBox="0 0 24 24" fill="none">
              <path d="M17 10.25H16.75V8C16.75 6.74022 16.2496 5.53204 15.3588 4.64124C14.468 3.75045 13.2598 3.25 12 3.25C10.7402 3.25 9.53204 3.75045 8.64124 4.64124C7.75045 5.53204 7.25 6.74022 7.25 8V10.25H7C6.27065 10.25 5.57118 10.5397 5.05546 11.0555C4.53973 11.5712 4.25 12.2707 4.25 13V18C4.25 18.7293 4.53973 19.4288 5.05546 19.9445C5.57118 20.4603 6.27065 20.75 7 20.75H17C17.7293 20.75 18.4288 20.4603 18.9445 19.9445C19.4603 19.4288 19.75 18.7293 19.75 18V13C19.75 12.2707 19.4603 11.5712 18.9445 11.0555C18.4288 10.5397 17.7293 10.25 17 10.25ZM8.75 8C8.75 7.13805 9.09241 6.3114 9.7019 5.7019C10.3114 5.09241 11.138 4.75 12 4.75C12.862 4.75 13.6886 5.09241 14.2981 5.7019C14.9076 6.3114 15.25 7.13805 15.25 8V10.25H8.75V8ZM18.25 18C18.25 18.3315 18.1183 18.6495 17.8839 18.8839C17.6495 19.1183 17.3315 19.25 17 19.25H7C6.66848 19.25 6.35054 19.1183 6.11612 18.8839C5.8817 18.6495 5.75 18.3315 5.75 18V13C5.75 12.6685 5.8817 12.3505 6.11612 12.1161C6.35054 11.8817 6.66848 11.75 7 11.75H17C17.3315 11.75 17.6495 11.8817 17.8839 12.1161C18.1183 12.3505 18.25 12.6685 18.25 13V18Z" fill="currentColor"/>
            </svg>
            {{- 'cart.general.checkout' | t -}}

            {%- if section.settings.show_price_in_checkout_button -%}
              <span class="cart-drawer__button-price">{{- cart.total_price | money -}}</span>
            {%- endif -%}
          {%- endcapture -%}

          {%- render 'button', type: 'submit', content: checkout_button, name: 'checkout', stretch: true -%}
        {%- endif -%}
      </div>

      <div id="vescartes-cart-benefits" class="vescartes-cart-benefits">
        <div class="vescartes-cart-benefits__items">
          <div class="vescartes-cart-benefits__item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M5.50001 12.5C5.50001 12.7652 5.39466 13.0196 5.20712 13.2071C5.01958 13.3947 4.76523 13.5 4.50001 13.5C4.2348 13.5 3.98044 13.3947 3.79291 13.2071C3.60537 13.0196 3.50001 12.7652 3.50001 12.5M5.50001 12.5C5.50001 12.2348 5.39466 11.9804 5.20712 11.7929C5.01958 11.6054 4.76523 11.5 4.50001 11.5C4.2348 11.5 3.98044 11.6054 3.79291 11.7929C3.60537 11.9804 3.50001 12.2348 3.50001 12.5M5.50001 12.5H9.50001M3.50001 12.5H2.25001C2.0511 12.5 1.86033 12.421 1.71968 12.2803C1.57903 12.1397 1.50001 11.9489 1.50001 11.75V9.50001M9.50001 12.5H11M9.50001 12.5V9.50001M1.50001 9.50001V4.41001C1.49895 4.22746 1.56565 4.051 1.68721 3.9148C1.80876 3.77859 1.97652 3.69232 2.15801 3.67268C4.38004 3.44203 6.61998 3.44203 8.84201 3.67268C9.21868 3.71135 9.50001 4.03135 9.50001 4.41001V5.04868M1.50001 9.50001H9.50001M13 12.5C13 12.7652 12.8947 13.0196 12.7071 13.2071C12.5196 13.3947 12.2652 13.5 12 13.5C11.7348 13.5 11.4804 13.3947 11.2929 13.2071C11.1054 13.0196 11 12.7652 11 12.5M13 12.5C13 12.2348 12.8947 11.9804 12.7071 11.7929C12.5196 11.6054 12.2652 11.5 12 11.5C11.7348 11.5 11.4804 11.6054 11.2929 11.7929C11.1054 11.9804 11 12.2348 11 12.5M13 12.5H13.75C14.164 12.5 14.5027 12.164 14.4767 11.7507C14.3427 9.54911 13.6013 7.42772 12.3347 5.62201C12.214 5.45287 12.0565 5.31336 11.874 5.21403C11.6916 5.11471 11.4889 5.05817 11.2813 5.04868H9.50001M9.50001 5.04868V9.50001" stroke="#1C1C1C" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Tracked next-day dispatch</span>
          </div>

          <div class="vescartes-cart-benefits__item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M6 2L2 6L6 10M2 6H10C11.0609 6 12.0783 6.42143 12.8284 7.17157C13.5786 7.92172 14 8.93913 14 10C14 11.0609 13.5786 12.0783 12.8284 12.8284C12.0783 13.5786 11.0609 14 10 14H8" stroke="#1C1C1C" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>14-Day Easy Returns</span>
          </div>
        </div>

        <div class="vescartes-cart-benefits__payments">
          <img src="https://cdn.shopify.com/s/files/1/0873/3546/9381/files/visa-bw.svg?v=1783687359" alt="Visa" loading="lazy">
          <img src="https://cdn.shopify.com/s/files/1/0873/3546/9381/files/mastercard-bw.svg?v=1783687357" alt="Mastercard" loading="lazy">
          <img src="https://cdn.shopify.com/s/files/1/0873/3546/9381/files/shop_pay-bw.svg?v=1783687354" alt="Shop Pay" loading="lazy">
          <img src="https://cdn.shopify.com/s/files/1/0873/3546/9381/files/amex-bw.svg?v=1783687352" alt="American Express" loading="lazy">
          <img src="https://cdn.shopify.com/s/files/1/0873/3546/9381/files/discover-bw.svg?v=1783687349" alt="Discover" loading="lazy">
          <img src="https://cdn.shopify.com/s/files/1/0873/3546/9381/files/diners.svg?v=1783687346" alt="Diners Club" loading="lazy">
          <img src="https://cdn.shopify.com/s/files/1/0873/3546/9381/files/UnionPay_logo_1.svg?v=1783687489" alt="UnionPay" loading="lazy">
          <img src="https://cdn.shopify.com/s/files/1/0873/3546/9381/files/jcb.svg?v=1783687344" alt="JCB" loading="lazy">
          <img src="https://cdn.shopify.com/s/files/1/0873/3546/9381/files/Klarna.svg?v=1783687343" alt="Klarna" loading="lazy">
        </div>
      </div>
      <div>
        <div class="Drawer__USPS">
          <div class="Drawer__USP">
              <svg width="20" height="20" viewBox="0 0 21 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <style>.cls-1{fill:#000;}.cls-1,.cls-2{stroke-width:0px;}.cls-2{fill:#fff;}</style>
                </defs>
                <path class="cls-1" d="M19.87,6.75s.02,2.96,0,4.02c0,.14-.05.27-.13.38l-1.87,2.44c-.13.18-.34.29-.57.29H7.42c-.25,0-.46-.21-.46-.46v-4.96c0-.27.13-.52.34-.68l2.1-1.57c.24-.18.53-.27.82-.27h9.06c.33,0,.58.27.58.6,0,.05,0,.22,0,.22Z"></path>
                <path class="cls-2" d="M11.26,10.95v.04c-.02.36-.38.34-.38.34h-.23v-.72h.3c.34.05.31.35.31.35M11.02,10.31h-.68v1.3h.65c.56-.05.56-.57.56-.57v-.17c-.05-.54-.53-.56-.53-.56"></path>
                <path class="cls-2" d="M14.83,10.95v.04c-.02.36-.38.34-.38.34h-.23v-.72h.3c.34.05.31.35.31.35M14.6,10.31h-.68v1.3h.65c.56-.05.56-.57.56-.57v-.17c-.05-.54-.53-.56-.53-.56"></path>
