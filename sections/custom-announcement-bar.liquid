            </svg>
          </span>
          <span>{{ section.settings.social_handle }}</span>
          <span>{{ section.settings.follower_count }}k</span>
        </div>
      {% endif %}

      </div>
    </div>

    <!-- Middle Section: Promotional Slides -->
    <div class="banner-middle">
      <div class="carousel">
        {% for block in section.blocks %}
          <div class="slide">
            <a href="{{ block.settings.slide_link }}">{{ block.settings.slide_text }}</a>
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- Right Section: Worldwide Shipping -->
    <div class="banner-right">
       <span>{{ section.settings.shipping_text }}</span>
       <img loading="lazy" src="https://cdn.shopify.com/s/files/1/0873/3546/9381/files/D507BFC9-F070-48B7-8298-7DCAEB8FE590.png?v=1756567793" width="22" height="22">
    </div>
  </div>
</div>

<style>
  /* Reset Defaults */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* Banner Base Styles */
  .top-banner {
    background-color: #000;
    color: #fff;
    padding: 12px 20px;
    font-family: 'Arial', sans-serif;
  }

  /* Container for Flex Layout */
  .banner-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Left Section: Rating & Social Media */
  .banner-left {
    display: flex;
    gap: 30px;
  }


  .banner-item.rating .rating-text {
    font-size: 14px;
    
  }
.banner-right span {
      line-height: 14px;
}

span.rating-text.count-text {
    line-height: 10px;
}
  .banner-item.social {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }

  .banner-item.social i {
    color: #1da1f2; /* Twitter blue */
  }

  /* Middle Section: Promotional Slides */
  .banner-middle .carousel {
    position: relative;
    height: 24px;
    overflow: hidden;
  }

  .carousel .slide {
    font-size: 16px;
    font-weight: 500;
  }

.carousel .slide{
  justify-content: center;
}

  /* Right Section: Worldwide Shipping */
  .banner-right {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    text-align:right;
  }

  .banner-right i {
    color: #fff;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .banner-container {
      flex-direction: column;
      gap: 10px;
    }

    .banner-left,
    .banner-middle,
    .banner-right {
      width: 100%;
    }
  }


  .banner-middle {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
}

.banner-left, .banner-right {
    width: 40%;
}
.banner-right{
    justify-content: flex-end;
}



.banner-middle .carousel {
    width: 100%;
    text-align: center;
}

.banner-container {
    max-width: 100%;
    padding: 0 30px;
}



.banner-item, .slide {
    opacity: 0;
    visibility: hidden;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
   display: flex;
    align-items: unset;
    gap: 0;
}
.banner-item{
  left: 100px;
}
.slide{
  left: -100px;
}

.banner-left {
    position: relative;
}

.banner-item.active, .slide.active {
    opacity: 1;
    visibility: visible;
    transition: .5s ease all;
    
}
.banner-item.active{
    left: 0;
}

.slide.active {
    left: 0;
}



.banner-item.rating .stars {
    display: flex;
    align-items: center;
    color: currentColor;
    margin: 0;
}

.banner-item.rating svg {
    width: 15px;
    height: 15px;
}
.banner-item, .carousel .slide, .banner-right{
    font-size: 11px !important;
}

.banner-item.rating .rating-text {
    font-size: inherit;
}

.top-banner {
    padding: 5px 20px;
}
span.rating-text.rating-text{
    display: flex;
    align-items: center;
    margin-left: 3px;
}
span.rating-text.count-text {
    width: 100%;
}
@media (max-width: 768px) {

.banner-middle {
    display: none;
}

.banner-container {
    padding: 0;
    flex-direction: row;
}

.banner-left, .banner-right {
    width: 100%;
}
.top-banner {
    padding-left: 10px;
    padding-right: 10px;
}
}

.banner-item.rating {
    flex-wrap: wrap;
}

.left-banner-wrapper {
    height: 35px;
}

.banner-item.rating .rating-text:not(.count-text) {
    text-decoration: underline;
}

.carousel .slide {
    text-transform: uppercase;
    align-items: center;
}
.carousel .slide:hover {
    text-decoration: underline;
    cursor: pointer;
}

</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
    // Left Carousel: Rotate between Rating & Social Media
    const leftItems = document.querySelectorAll('.banner-left .banner-item');
    let leftIndex = 0;

    function showLeftItem(index) {
      leftItems.forEach(item => item.classList.remove('active'));
      leftItems[index].classList.add('active');
    }

    showLeftItem(leftIndex); // Show initial item (rating)

    setInterval(() => {
      leftIndex = (leftIndex + 1) % leftItems.length;
      showLeftItem(leftIndex);
    }, 5000); // Rotate every 5 seconds

    // Middle Carousel: Rotate Promotion Slides
    const middleSlides = document.querySelectorAll('.banner-middle .slide');
    let middleIndex = 0;

    function showMiddleSlide(index) {
      middleSlides.forEach(slide => slide.classList.remove('active'));
      middleSlides[index].classList.add('active');
    }

    showMiddleSlide(middleIndex); // Show initial slide

    setInterval(() => {
      middleIndex = (middleIndex + 1) % middleSlides.length;
      showMiddleSlide(middleIndex);
    }, 4000); // Rotate every 4 seconds
  });  
</script>

{% schema %}
{
  "name": "Announcement Custom",
  "settings": [
    {
      "type": "color",
      "id": "bg_clr",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "text_clr",
      "label": "Text Color"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "review-text",
      "label": "Review Rating Text",
      "default": "4.7/5 out of 5"
    },
    {
      "type": "inline_richtext",
      "id": "review-count",
      "label": "Review Count Text",
      "default": "based on 5468 reviews"
    },
    {
      "type": "checkbox",
      "id": "show_social_media",
      "label": "Show Social Media",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "social_handle",
      "label": "Social Media Handle",
      "default": "@vicinity_de"
    },
    {
      "type": "inline_richtext",
      "id": "follower_count",
      "label": "Follower Count (in thousands)",
      "default": "632"
    },
    {
      "type": "textarea",
      "id": "shipping_text",
      "label": "Shipping Text",
      "default": "WORLDWIDE SHIPPING"
    }
  ],
  "blocks": [
    {
      "type": "promotion",
      "name": "Promotion Slide",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "slide_text",
          "label": "Slide Text",
          "default": "EVERYDAY JEANS: BASIC DENIMS"
        },
        {
          "type": "url",
          "id": "slide_link",
          "label": "Slide Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Custom",
      "category": "Header"
    }
  ]
}
{% endschema %}