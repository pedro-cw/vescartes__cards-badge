  {%- comment -%} Main Row: Newsletter + Menus {%- endcomment -%}
  <div class="cf-main">
    
    <div class="cf-newsletter">
      <h3 class="cf-newsletter-heading">{{ section.settings.newsletter_heading | escape }}</h3>
      {% form 'customer', class: 'cf-form-wrapper' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input 
          type="email" 
          name="contact[email]" 
          class="cf-input" 
          placeholder="{{ section.settings.newsletter_placeholder | escape }}" 
          required
        >
        <button type="submit" class="cf-submit" aria-label="Submit">
          <svg viewBox="0 0 24 24"><path d="M5 3l3.057-3 11.943 12-11.943 12-3.057-3 9-9z"/></svg>
        </button>
      {% endform %}
    </div>

    <div class="cf-menus">
      {% for block in section.blocks %}
        <div class="cf-menu-block" {{ block.shopify_attributes }}>
          
          {% if block.type == 'single_link' %}
            <a href="{{ block.settings.link }}" class="cf-menu-single-link">{{ block.settings.title | escape }}</a>
          
          {% elsif block.type == 'accordion_menu' %}
            <button class="cf-menu-heading js-accordion-toggle">
              {{ block.settings.title | escape }}
              <svg viewBox="0 0 24 24"><path d="M0 7.33l2.829-2.83 9.175 9.339 9.167-9.339 2.829 2.83-11.996 12.17z"/></svg>
            </button>
            <div class="cf-menu-content js-accordion-content">
              {% if block.settings.menu != blank %}
                <ul class="cf-menu-list">
                  {% for link in linklists[block.settings.menu].links %}
                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% endif %}

        </div>
      {% endfor %}
    </div>
  </div>

  {%- comment -%} Payment Icons {%- endcomment -%}
  {% if section.settings.show_payments %}
    <div class="cf-payments">
      {% for type in shop.enabled_payment_types %}
        {{ type | payment_type_svg_tag }}
      {% endfor %}
    </div>
  {% endif %}


  {% if section.settings.logo_icon != blank %}
    <div class="logo-icon-wrapper">
      {{ section.settings.logo_icon | image_url: width: section.settings.logo_icon.width | image_tag: class: 'footer-logo-icon' }}
    </div>
  {% endif %}
  

</footer>

{%- comment -%} JavaScript for Mobile Accordion {%- endcomment -%}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const toggles = document.querySelectorAll('.js-accordion-toggle');
    
    toggles.forEach(toggle => {
      toggle.addEventListener('click', function() {
        // Prevent toggle on desktop where CSS pointer-events is none anyway, but just to be safe
        {% comment %} if(window.innerWidth >= 769) return; {% endcomment %} 

        this.classList.toggle('is-active');
        const content = this.nextElementSibling;
        
        if (content.classList.contains('is-open')) {
          content.classList.remove('is-open');
        } else {
          content.classList.add('is-open');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Custom Footer",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#540000"
