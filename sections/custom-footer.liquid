{%- comment -%} CSS Variables and Styles {%- endcomment -%}
<style>
  .custom-footer {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --accent-color: {{ section.settings.text_color }};
    
    --size-top-text-mob: {{ section.settings.top_text_size_mob }}px;
    --size-top-text-desk: {{ section.settings.top_text_size_desk }}px;
    --size-social-icon: {{ section.settings.social_icon_size }}px;
    --size-heading-mob: {{ section.settings.heading_size_mob }}px;
    --size-heading-desk: {{ section.settings.heading_size_desk }}px;
    --size-body-mob: {{ section.settings.body_size_mob }}px;
    --size-body-desk: {{ section.settings.body_size_desk }}px;

    background-color: var(--bg-color);
    color: var(--text-color);
    padding: 40px 20px;
    font-family: inherit;
  }

  .custom-footer * {
    box-sizing: border-box;
  }

  .custom-footer a {
    color: var(--text-color);
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .custom-footer a:hover {
    opacity: 0.7;
  }

  /* --- Top Banner --- */
  .cf-top-banner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--border-color);
    text-align: center;
  }
  .cf-top-text {
    font-size: var(--size-top-text-mob);
    line-height: 1.2;
    margin: 0;
  }

  /* --- Social Icons --- */
  .cf-socials {
    display: flex;
    justify-content: center;
    gap: 20px;
    padding: 30px 0;
  }
  .cf-socials svg {
    width: var(--size-social-icon);
    height: var(--size-social-icon);
    fill: var(--text-color);
  }

  /* --- Main Layout (Newsletter + Menus) --- */
  .cf-main {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-bottom: 20px;
  }

  /* Newsletter */
  .cf-newsletter {
    width: 100%;
  }
  .cf-newsletter-heading {
    font-size: var(--size-heading-mob);
    margin: 0 0 15px 0;
  }
  .cf-form-wrapper {
    position: relative;
    display: flex;
    border-bottom: 1px solid var(--text-color);
    padding-bottom: 10px;
  }
  .cf-input {
    width: 100%;
    background: transparent;
    border: none;
    color: var(--text-color);
    font-size: var(--size-body-mob);
    outline: none;
  }
  .cf-input::placeholder {
    color: var(--text-color);
    opacity: 0.8;
  }
  .cf-submit {
    background: transparent;
    border: none;
    color: var(--text-color);
    cursor: pointer;
    padding: 0 5px;
  }
  .cf-submit svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  /* Menus (Accordion Mobile) */
  .cf-menus {
    display: flex;
    flex-direction: column;
    gap: 0px;
  }
  .cf-menu-block {
    border-bottom: none;
  }
  .cf-menu-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    background: transparent;
    border: none;
    color: var(--text-color);
    font-size: var(--size-heading-mob);
    font-weight: bold;
    text-align: left;
    padding: 10px 0;
    cursor: pointer;
  }
  .cf-menu-heading svg {
    width: 12px;
    height: 12px;
    fill: currentColor;
    transition: transform 0.3s ease;
  }
  .cf-menu-heading.is-active svg {
    transform: rotate(180deg);
  }
  .cf-menu-content {
    display: none;
    padding-top: 10px;
    padding-bottom: 10px;
  }
  .cf-menu-content.is-open {
    display: block;
  }
  .cf-menu-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .cf-menu-list a {
    font-size: var(--size-body-mob);
  }

  /* Single Links masquerading as headings */
  .cf-menu-single-link {
    font-size: var(--size-heading-mob);
    font-weight: bold;
    display: block;
    padding: 10px 0;
  }

  /* --- Payments --- */
  .cf-payments {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 20px;
    align-items: center;
  }
  .cf-payments svg {
    height: 24px;
    width: auto;
    filter: grayscale(100%);
  }

  .logo-icon-wrapper img.footer-logo-icon {
    max-width: 60px;
    margin: 0 auto;
}

  /* --- Desktop Responsiveness --- */
  @media (min-width: 769px) {
    .custom-footer {
      padding: 60px 40px;
    }
    .cf-top-banner {
      flex-direction: row;
      justify-content: space-between; /* Side by side */
      padding-bottom: 40px;
    }
    .cf-top-text {
      font-size: var(--size-top-text-desk);
    }
    .cf-socials {
      padding: 40px 0;
    }
    .cf-main {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      padding-bottom: 30px;
    }
    .cf-newsletter {
      width: 35%;
    }
    .cf-newsletter-heading {
      font-size: var(--size-heading-desk);
    }
    .cf-input {
      font-size: var(--size-body-desk);
    }
    .cf-menus {
      width: 25%;
      {% comment %} flex-direction: row; {% endcomment %}
      justify-content: space-between;
      gap: 30px;
    }
    .cf-menu-block {
      flex: 1;
    }
    .cf-menu-heading {
      font-size: var(--size-heading-desk);
      cursor: pointer;
      {% comment %} pointer-events: none; {% endcomment %} /* Disable accordion toggle on desktop */
      padding-top: 0;
    }
    {% comment %} .cf-menu-heading svg {
      display: none; /* Hide chevron on desktop */
    } {% endcomment %}
    .cf-menu-single-link {
      font-size: var(--size-heading-desk);
      padding-top: 0;
    }
    {% comment %} .cf-menu-content {
      display: block !important; /* Always show menu on desktop */
      padding-top: 20px;
    } {% endcomment %}
    .cf-menu-list a {
      font-size: var(--size-body-desk);
    }
  }
</style>

