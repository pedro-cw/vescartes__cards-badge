    {
      "type": "range",
      "id": "body_size_desk",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Body Text Size (Desktop)",
      "default": 14
    },
    {
      "type": "header",
      "content": "Top Banner Texts"
