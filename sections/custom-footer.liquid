      "id": "heading_size_desk",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Heading Size (Desktop)",
      "default": 18
    },
    {
      "type": "range",
      "id": "body_size_mob",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Body Text Size (Mobile)",
