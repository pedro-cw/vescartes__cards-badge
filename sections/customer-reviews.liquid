{%- comment -%}
  "Customer Reviews" — heading, a rating summary line, and a carousel of review
  cards. One block per review. One card at a time on mobile (with arrows and
  drag); a three-card window on desktop, with the rest reachable by the arrows.
{%- endcomment -%}

{%- liquid
  assign rating = section.settings.rating | default: 4.5

  # A range setting stores 5 as 5.0, which would read "Rated 5.0" — print
  # whole ratings without the decimal.
  assign rounded_rating = rating | round

  if rating == rounded_rating
    assign rating_text = rounded_rating | append: ''
  else
    assign rating_text = rating | append: ''
  endif

  assign summary_text = section.settings.summary_text | replace: '[rating]', rating_text | replace: '[label]', section.settings.rating_label
  assign summary_sub = section.settings.summary_sub | replace: '[count]', section.settings.reviews_count

  assign left_arrow = '<svg aria-hidden="true" focusable="false" fill="none" width="16" class="icon icon-arrow-left icon--direction-aware" viewBox="0 0 16 18"><path d="M11 1 3 9l8 8" stroke="currentColor" stroke-linecap="square"></path></svg>'
  assign right_arrow = '<svg aria-hidden="true" focusable="false" fill="none" width="16" class="icon icon-arrow-right icon--direction-aware" viewBox="0 0 16 18"><path d="m5 17 8-8-8-8" stroke="currentColor" stroke-linecap="square"></path></svg>'
-%}

{%- comment -%}
  Captured first so a section whose blocks are all still empty renders nothing
  at all, rather than a heading and arrows around an empty track.
{%- endcomment -%}
{%- capture cards -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.title != blank or block.settings.text != blank -%}
      <li class="customer-reviews__card" {{ block.shopify_attributes }}>
        <span class="customer-reviews__card-stars" role="img" aria-label="Rated {{ block.settings.rating }} out of 5">
          {%- render 'rating-stars', rating: block.settings.rating, uid: block.id -%}
        </span>

        {%- if block.settings.title != blank -%}
          <p class="customer-reviews__card-title">{{ block.settings.title | escape }}</p>
        {%- endif -%}

        {%- if block.settings.text != blank -%}
          <p class="customer-reviews__card-text">"{{ block.settings.text | escape }}"</p>
        {%- endif -%}

        {%- if block.settings.name != blank or block.settings.initials != blank -%}
          <div class="customer-reviews__card-author">
            {%- if block.settings.initials != blank -%}
              <span class="customer-reviews__avatar" aria-hidden="true">{{ block.settings.initials | escape }}</span>
            {%- endif -%}

            <span class="customer-reviews__author-info">
              <span class="customer-reviews__author-name">{{ block.settings.name | escape }}</span>
            </span>
          </div>
        {%- endif -%}
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if cards != blank -%}
  <style>
    /* The single auto-width column of the <main> grid has no minmax(0, ...),
       so it sizes to the widest grid item's min-content — and the carousel's
       min-content is ~900px. Without this the column grows past the viewport
       on a phone and every section in it gets laid out too wide, with the
       excess clipped by main's overflow-x: hidden (so it looks cut off rather
       than scrollable). The section wrapper is the grid item, so it needs the
       min-width, not just the inner element. */
    .shopify-section--customer-reviews,
    .customer-reviews {
      min-width: 0;
    }

    /* Spacing between heading / summary / carousel is a single `gap` on the
       flex container, so it stays even regardless of which order they are in
       at a given breakpoint (no doubled-up margins). */
    .customer-reviews {
      padding: 0;
      /* <main> no longer spaces its children (see main.product in
         custom.css), so this adds the gap back below the section. Same
         variable the theme's own section spacing uses, so it follows the
         global spacing setting: 2.5rem here, 4rem from 1000px up. */
      margin-bottom: var(--section-vertical-spacing, 2.5rem);
    }

    .customer-reviews__inner {
      display: flex;
      flex-direction: column;
      gap: 16px;
      max-width: 1500px;
      margin: 0 auto;
    }

    /* Font styling comes from the theme's own ".h2" utility class (added
       alongside this one in the markup) — the same class the theme uses for
       its native headings like "More from Vescartes" — so this only carries
       layout that ".h2" doesn't: flex order, centering and spacing. */
    .customer-reviews__heading {
      order: 0;
      margin: 0;
      text-align: center;
    }

    /* On mobile the summary sits below the carousel; on desktop it moves
       above it (see the order swap further down). */
    .customer-reviews__summary {
      order: 2;
      margin: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
    }

    /* Stars sit next to the bolded rating on the same line; the "on
       TrustPilot" sentence stacks below as its own line. */
    .customer-reviews__summary-top {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .customer-reviews__summary-text {
      color: #1c1c1c;
      font-family: 'URW DIN', sans-serif;
      font-size: 12px;
      font-style: normal;
      font-weight: 700;
      line-height: normal;
    }

    .customer-reviews__summary-sub {
      color: #1c1c1c;
      font-family: 'URW DIN', sans-serif;
      font-size: 12px;
      font-style: normal;
      font-weight: 400;
      line-height: normal;
    }

    .customer-reviews__stars {
      display: flex;
    }

    .customer-reviews__carousel {
      order: 1;
      position: relative;
      padding: 0 12px;
      margin-top: 20px;
    }

    .customer-reviews__track {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      margin: 0;
      padding: 0;
      list-style: none;
      overflow-x: auto;
      /* Without this, the CSS overflow spec force-changes overflow-y to
         "auto" (since overflow-x isn't "visible") — so once JS pins the
         track's height to the active card, a taller neighbouring card in the
         same row makes the track vertically scrollable, letting a swipe
         reveal that other card's overflow while still snapped on the short
         one. Explicit "hidden" clips it instead. */
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      cursor: grab;
      /* Without this, dragging to scroll (mousedown + mousemove) also selects
         the card text underneath the cursor, like any other click-drag. */
      user-select: none;
      -webkit-user-select: none;
      /* JS sets an explicit height on mobile matching the active card;
         animate it so switching between reviews of different lengths doesn't
         jump. */
      transition: height 0.2s ease;
    }

    .customer-reviews__track:active {
      cursor: grabbing;
    }

    .customer-reviews__track::-webkit-scrollbar {
      display: none;
    }

    .customer-reviews__card {
      /* Height follows its own content (align-items: flex-start on the track
         stops flex from stretching every card to match the tallest one).
         Width caps at 371px on both mobile and desktop. */
      flex: 0 0 auto;
      width: 100%;
      max-width: 371px;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      gap: 12px;
      background: #fdfcf5;
      padding: 32px 42px;
      /* The theme applies its own padding-inline-start to bare <li>
         elements, which otherwise overrides the left side of the padding
         above. */
      padding-inline-start: 32px !important;
      scroll-snap-align: start;
    }

    .customer-reviews__card-stars {
      display: inline-flex;
    }

    .customer-reviews__card-title {
      margin: 0;
      color: #1c1c1c;
      -webkit-text-stroke-width: 0.4px;
      -webkit-text-stroke-color: #1c1c1c;
      font-family: 'URW DIN', sans-serif;
      font-size: 16px;
      font-style: normal;
      font-weight: 400;
      line-height: normal;
    }

    .customer-reviews__card-text {
      margin: 0;
      flex: 1 1 auto;
      color: #1c1c1c;
      font-family: 'URW DIN', sans-serif;
      font-size: 16px;
      font-style: normal;
      font-weight: 400;
      line-height: normal;
    }

    .customer-reviews__card-author {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .customer-reviews__avatar {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #f0dcc0;
      color: #1c1c1c;
      font-family: 'URW DIN', sans-serif;
      font-size: 13px;
      font-weight: 600;
    }

    .customer-reviews__author-info {
      display: flex;
      flex-direction: column;
    }

    .customer-reviews__author-name {
      color: #1c1c1c;
      text-align: center;
      -webkit-text-stroke-width: 0.3px;
      -webkit-text-stroke-color: #1c1c1c;
      /* The brand font is registered as "AcciaPiano" in custom.css — the
         design's "Accia Piano" (with a space) matches no loaded family and
         silently fell back to sans-serif. */
      font-family: 'AcciaPiano', sans-serif;
      font-size: 14px;
      font-style: normal;
      font-weight: 350;
      line-height: normal;
    }

    .customer-reviews__arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: none;
      color: #9c9c9c;
      cursor: pointer;
      transition: opacity 0.2s;
    }

    .customer-reviews__arrow--prev {
      left: 20px;
    }

    .customer-reviews__arrow--next {
      right: 20px;
    }

    .customer-reviews__arrow.is-disabled {
      opacity: 0.3;
      pointer-events: none;
    }

    @media screen and (min-width: 1000px) {
      .customer-reviews__summary {
        order: 1;
        flex-direction: row;
      }

      .customer-reviews__carousel {
        order: 2;
        /* Extra breathing room between the rating line and the cards below
           it, on top of the section's regular 16px rhythm. */
        margin-top: 24px;
        /* Caps the desktop carousel to exactly 3 cards plus the two 24px gaps
           between them (the same card/gap sizing the track uses) and centres
           it. Without this every card sits in one unclipped row, which
           overflows the page once there are more than three — capping the
           width is what makes this an actual 3-at-a-time carousel on desktop.
           box-sizing is explicit so the max-width, which is meant to include
           this element's own padding, comes out exact regardless of the
           theme's global box-sizing default. */
        box-sizing: border-box;
        max-width: calc(3 * 371px + 2 * 24px + 2 * 12px);
        margin-left: auto;
        margin-right: auto;
        padding: 0 12px;
      }

      .customer-reviews__summary-text,
      .customer-reviews__summary-sub {
        font-size: 18px;
      }

      .customer-reviews__track {
        gap: 24px;
        margin-top: 20px;
      }

      /* Desktop only — pushes the arrows out past the card edges instead of
         overlapping them (mobile keeps the left: 20px / right: 20px above). */
      .customer-reviews__arrow--prev {
        left: -20px;
      }

      .customer-reviews__arrow--next {
        right: -20px;
      }
    }
  </style>

  {%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

  <div class="customer-reviews section-spacing color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }}">
    <div class="customer-reviews__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="customer-reviews__heading h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if summary_text != blank or summary_sub != blank -%}
        <div class="customer-reviews__summary">
          <div class="customer-reviews__summary-top">
            <span class="customer-reviews__stars" role="img" aria-label="Rated {{ rating_text }} out of 5">
              {%- render 'rating-stars', rating: rating, uid: section.id -%}
            </span>

            {%- if summary_text != blank -%}
              <span class="customer-reviews__summary-text">{{ summary_text }}</span>
            {%- endif -%}
          </div>

          {%- if summary_sub != blank -%}
            <span class="customer-reviews__summary-sub">{{ summary_sub }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="customer-reviews__carousel">
        <button type="button" class="customer-reviews__arrow customer-reviews__arrow--prev" aria-label="{{ 'general.accessibility.previous' | t }}">
          {{- left_arrow -}}
        </button>

        <ul class="customer-reviews__track" role="list">
          {{- cards -}}
        </ul>

        <button type="button" class="customer-reviews__arrow customer-reviews__arrow--next" aria-label="{{ 'general.accessibility.next' | t }}">
          {{- right_arrow -}}
        </button>
      </div>
    </div>
  </div>

  <script>
    (function () {
      const DESKTOP = '(min-width: 1000px)';

      function initCarousel(section) {
        if (section.dataset.customerReviewsReady === 'true') return;

        // Mobile-only section: display: none from 1000px up. Measuring card
        // heights while hidden gives zeros, so wait until it's on screen —
        // initAll runs again on resize.
        if (!section.offsetParent) return;

        section.dataset.customerReviewsReady = 'true';

        const track = section.querySelector('.customer-reviews__track');
        const prevBtn = section.querySelector('.customer-reviews__arrow--prev');
        const nextBtn = section.querySelector('.customer-reviews__arrow--next');
        if (!track || !prevBtn || !nextBtn) return;

        const getStep = () => {
          const card = track.querySelector('.customer-reviews__card');
          if (!card) return track.clientWidth;
          const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
          return card.getBoundingClientRect().width + gap;
        };

        const updateArrowState = () => {
          const maxScroll = track.scrollWidth - track.clientWidth - 1;
          prevBtn.classList.toggle('is-disabled', track.scrollLeft <= 0);
          nextBtn.classList.toggle('is-disabled', track.scrollLeft >= maxScroll);
        };

        // On mobile only one card is visible at a time — size the track to
        // whichever card is currently snapped into view, instead of leaving it
        // as tall as the longest review in the list. Desktop shows three at
        // once, so the height is left to the content there.
        const updateTrackHeight = () => {
          if (window.matchMedia(DESKTOP).matches) {
            track.style.height = '';
            return;
          }

          const cards = track.querySelectorAll('.customer-reviews__card');
          let activeCard = cards[0];
          let smallestOffset = Infinity;

          cards.forEach((card) => {
            const offset = Math.abs(card.offsetLeft - track.scrollLeft);
            if (offset < smallestOffset) {
              smallestOffset = offset;
              activeCard = card;
            }
          });

          if (activeCard) track.style.height = activeCard.offsetHeight + 'px';
        };

        const updateState = () => {
          updateArrowState();
          updateTrackHeight();
        };

        prevBtn.addEventListener('click', () => {
          track.scrollBy({ left: -getStep(), behavior: 'smooth' });
        });

        nextBtn.addEventListener('click', () => {
          track.scrollBy({ left: getStep(), behavior: 'smooth' });
        });

        track.addEventListener('scroll', () => {
          window.requestAnimationFrame(updateState);
        });

        window.addEventListener('resize', updateState);

        // Card height depends on the web fonts having landed, so measure again
        // once they have rather than only on first paint.
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(updateState);
        }

        updateState();

        // --- Drag to scroll (mouse) ---
        let isDown = false;
        let startX = 0;
        let scrollStart = 0;

        track.addEventListener('mousedown', (event) => {
          isDown = true;
          // Smooth scrolling is for the arrows; during a drag the track has to
          // follow the cursor one-to-one.
          track.style.scrollBehavior = 'auto';
          startX = event.pageX;
          scrollStart = track.scrollLeft;
        });

        window.addEventListener('mouseup', () => {
          if (!isDown) return;
          isDown = false;
          track.style.scrollBehavior = 'smooth';
        });

        window.addEventListener('mousemove', (event) => {
          if (!isDown) return;
          event.preventDefault();
          track.scrollLeft = scrollStart - (event.pageX - startX);
        });
      }

      const initAll = (root) => {
        (root || document)
          .querySelectorAll('.customer-reviews')
          .forEach((section) => initCarousel(section));
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => initAll());
      } else {
        initAll();
      }

      // Crossing down over the breakpoint reveals the section, and it still
      // needs wiring up then.
      window.addEventListener('resize', () => initAll());

      // The theme editor re-renders the section from scratch on every settings
      // change, so the fresh markup needs wiring up again.
      document.addEventListener('shopify:section:load', (event) => initAll(event.target));
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Customer Reviews",
  "class": "shopify-section--customer-reviews",
  "tag": "section",
  "max_blocks": 24,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Reviews"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Rating summary"
    },
    {
      "type": "range",
      "id": "rating",
      "label": "Rating",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "default": 4.5
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Rating label",
      "default": "Excellent"
    },
    {
      "type": "number",
      "id": "reviews_count",
      "label": "Total number of reviews",
      "default": 590
    },
    {
      "type": "text",
      "id": "summary_text",
      "label": "Summary line",
      "info": "[rating] and [label] are replaced with the values above.",
      "default": "Rated [rating] ([label])"
    },
    {
      "type": "text",
      "id": "summary_sub",
      "label": "Second line",
      "info": "[count] is replaced with the total number of reviews.",
      "default": "on TrustPilot based on [count] reviews"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 0,
          "max": 5,
          "step": 0.5,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Reviewer name"
        },
        {
          "type": "text",
          "id": "initials",
          "label": "Initials",
          "info": "Shown in the round avatar, for example JS."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews",
      "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }]
    }
  ]
}
{% endschema %}
