<div class="pw-page">
  <style>
    html,
    body {
      height: 100%;
      overflow-x: hidden;
      background: #000000;
      margin: 0;
      padding: 0;
      position: fixed;
      width: 100%;
    }

    body {
      margin: 0;
      padding: 0;
      background: #000000;
      color: #ffffff;
      font-family: 'Helvetica Neue', sans-serif;
      height: 100vh;
    }

    .pw-page {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 40px 20px;
      box-sizing: border-box;
      position: relative;
      background: #000000;
    }

    .pw-stack {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      width: 100%;
      max-width: 500px;
      margin: 0 auto;
      padding: 20px;
    }

    .pw-page__logo {
      margin-bottom: 40px;
    }

    .pw-page__logo img {
      max-width: 200px;
      height: auto;
    }

    .password-button {
      position: fixed;
      top: 20px;
      right: 20px;
      background: #181a1b;
      color: #a1a1a1;
      border: none;
      padding: 10px 20px;
      cursor: pointer;
      font-family: 'Helvetica Neue', sans-serif;
      z-index: 100;
    }

    .password-modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.5);
      z-index: 1000;
      justify-content: center;
      align-items: center;
    }

    .password-modal.active {
      display: flex;
    }

    .modal-content {
      background: #1a1a1a;
      color: #ffffff;
      padding: 30px;
      border-radius: 4px;
      width: 90%;
      max-width: 400px;
      position: relative;
    }

    .close-modal {
      position: absolute;
      right: 10px;
      top: 10px;
      background: none;
      border: none;
      font-size: 24px;
      cursor: pointer;
      color: #ffffff;
    }

    .password-form {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    .password-form input[type='password'] {
      font-size: 16px;
      padding: 10px;
      border: 1px solid #ffffff;
      width: 100%;
      background: #1a1a1a;
      color: #a1a1a1;
    }

    .password-form-submit {
      background: #ffffff;
      color: #000000;
      border: none;
      padding: 12px;
      cursor: pointer;
      font-family: 'Helvetica Neue', sans-serif;
      font-weight: 700;
      width: 100%;
    }

    #countdown {
      display: flex;
      justify-content: center;
      gap: 20px;
      text-align: center;
      margin: 0px 0;
      width: 100%;
    }

    div#countdown.expired {
      color: rgb(252, 250, 250);
      font-size: 20px;
      font-family: Helvetica, Arial, sans-serif;
      font-weight: 400;
      font-style: normal;
      max-width: 400px;
      flex-wrap: wrap;
      text-wrap-style: pretty;
    }

    span.expired-text {
      font-weight: 700;
      font-style: normal;
    }

    .support-links {
      flex-direction: column;
      display: flex;
      font-size: 18px;
    }

    .time-unit {
      min-width: 65px;
      display: flex;
      flex-direction: column;
      align-items: center;
      line-height: 1.1;
    }

    .time-value {
      font-size: 3.5em;
      font-weight: 400;
      display: block;
      font-family: 'Helvetica Neue', sans-serif;
      color: #ffffff;
          letter-spacing: 0.1em;
    }

    .time-label {
      font-size: 1.1em;
      text-transform: uppercase;
      color: #cccccc;
      font-family: 'Helvetica Neue', sans-serif;
      margin-top: 5px;
    }

    .klaviyo-form-section {
      width: 100%;
      max-width: 400px;
      margin: 20px auto;
      padding: 20px;
    }

    .klaviyo-form-section iframe {
      max-width: 100% !important;
    }

    .password-description {
      color: #ffffff;
      font-family: 'Helvetica Neue', sans-serif;
      font-weight: 400;
      font-style: normal;
      font-size: 1.1em;
      margin: 20px 0;
      max-width: 600px;
    }
div#countdown {
    padding-bottom: 25px;
}
    @media (max-width: 480px) {
      .pw-stack {
        padding: 10px;
      }

      .klaviyo-form-section {
        padding: 10px;
      }

      #countdown {
        gap: 10px;
      }

      .time-value {
        font-size: 2.8em;
      }

      .time-label {
        font-size: 1em;
      }
    }

    .pw-page * {
    font-family: var(--text-font-family) !important;
}
  </style>

  <button type="button" class="password-button" id="openPasswordModal">
    ENTER PASSWORD
  </button>

  <div class="password-modal" id="passwordModal">
    <div class="modal-content">
      <button type="button" class="close-modal" id="closePasswordModal">
        &times;
      </button>
      <form method="post" action="/password" id="login_form" accept-charset="UTF-8" class="password-form">
        <input type="hidden" name="form_type" value="storefront_password">
        <input type="hidden" name="utf8" value="✓">
        <input class="password-form-input" type="password" name="password" placeholder="Enter password" required>
        <button type="submit" class="password-form-submit">ENTER</button>
      </form>
    </div>
  </div>

  <div class="pw-stack">
    <div class="pw-page__logo">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 2000 }}"
          alt="{{ shop.name }}"
          width="120"
          height="120"
          loading="lazy"
        >
      {%- endif -%}
    </div>

    {%- if section.settings.description_text != blank -%}
      <p class="password-description">{{ section.settings.description_text }}</p>
    {%- endif -%}

    <div id="countdown">
      <div class="time-unit">
        <span id="days" class="time-value"></span>
        <span class="time-label">days</span>
      </div>
      <div class="time-unit">
        <span id="hours" class="time-value"></span>
        <span class="time-label">hours</span>
      </div>
      <div class="time-unit">
        <span id="minutes" class="time-value"></span>
        <span class="time-label">minutes</span>
      </div>
      <div class="time-unit">
        <span id="seconds" class="time-value"></span>
        <span class="time-label">seconds</span>
      </div>
    </div>

 <div class="klaviyo-form-section">

      {% if  localization.market.handle  == 'gb'%}
      <div class="klaviyo-form-VaNNW4"></div>
      {% elsif localization.market.handle == 'usa' %}
      <div class="klaviyo-form-S2J7pL"></div>   
      {% else %}
      <div class="klaviyo-form-XDkw2v"></div>
      {% endif %}
      {% comment %} <div class="klaviyo-form-S2J7pL"></div>
      <div class="klaviyo-form-VaNNW4"></div>
      <div class="klaviyo-form-XDkw2v"></div> {% endcomment %}
      <script
        type="text/javascript"
        src="https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=Vc8Vj6"
      ></script>
      <script>
        // Force immediate script execution
        document.addEventListener('DOMContentLoaded', function() {
          // Simulate user interaction to trigger lazy-loaded scripts
          const event = new Event('mousemove');
          document.dispatchEvent(event);
        });
      </script>
    </div>
  </div>
</div>

<script>
  console.log('vesc');
  
  document.addEventListener('DOMContentLoaded', function () {
    const modal = document.getElementById('passwordModal');
    const openBtn = document.getElementById('openPasswordModal');
    const closeBtn = document.getElementById('closePasswordModal');

    openBtn.addEventListener('click', () => {
      modal.classList.add('active');
    });

    closeBtn.addEventListener('click', () => {
      modal.classList.remove('active');
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.remove('active');
      }
    });
  });

  function startCountdown() {
    const targetMonth = "{{ section.settings.target_month | default: '' }}";
    const targetDay = "{{ section.settings.target_day | default: '' }}";
    const targetHour = "{{ section.settings.target_hour | default: '' }}";
    const targetMinute = "{{ section.settings.target_minute | default: '' }}";

    const countdownElement = document.getElementById('countdown');
    const daysEl = document.getElementById('days');
    const hoursEl = document.getElementById('hours');
    const minutesEl = document.getElementById('minutes');
    const secondsEl = document.getElementById('seconds');

    if (
      !targetMonth ||
      !targetDay ||
      !targetHour ||
      !targetMinute ||
      !countdownElement ||
      !daysEl ||
      !hoursEl ||
      !minutesEl ||
      !secondsEl
    ) {
      if (countdownElement) {
        countdownElement.innerHTML = 'Countdown timer not configured.';
      }
      return;
    }

    let targetDateEST;
    try {
      const currentYear = new Date().getFullYear();

      const paddedMonth = targetMonth.padStart(2, '0');
      const paddedDay = targetDay.padStart(2, '0');
      const paddedHour = targetHour.padStart(2, '0');
      const paddedMinute = targetMinute.padStart(2, '0');

      const targetDateString = `${currentYear}-${paddedMonth}-${paddedDay}T${paddedHour}:${paddedMinute}:00`;

      targetDateEST = new Date(targetDateString + '-05:00');

      if (isNaN(targetDateEST.getTime())) {
        throw new Error('Invalid date constructed');
      }
    } catch (error) {
      console.error('Error parsing countdown date/time:', error);
      if (countdownElement) {
        countdownElement.innerHTML = 'Countdown timer configuration error.';
      }
      return;
    }

    function updateCountdown() {
      const now = new Date();
      const difference = targetDateEST.getTime() - now.getTime();

      if (difference <= 0) {
        countdownElement.innerHTML = `
          <span class="expired-text">{{ section.settings.countdown_expired_text | default: 'Launched!' }}</span>
          <div class="support-links">
            <a href="https://vescartesupdates.com">
              tracking: 
              <span style="text-decoration: underline">vescartesupdates.com</span>
            </a>
            <span>support: contact@vescartes.com</span>
          </div>
        `;
        countdownElement.classList.add('expired');
        clearInterval(interval);
        return;
      }

      const days = Math.floor(difference / (1000 * 60 * 60 * 24));
      const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((difference % (1000 * 60)) / 1000);

      daysEl.textContent = days;
      hoursEl.textContent = hours.toString().padStart(2, '0');
      minutesEl.textContent = minutes.toString().padStart(2, '0');
      secondsEl.textContent = seconds.toString().padStart(2, '0');
    }

    const interval = setInterval(updateCountdown, 1000);
    updateCountdown();
  }

  document.addEventListener('DOMContentLoaded', startCountdown);
</script>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "description_text",
      "label": "Description Text",
      "info": "Displays below the logo."
    },
    {
      "type": "text",
      "id": "target_month",
      "label": "Countdown Month (EST)",
      "info": "Enter month number (1-12)"
    },
    {
      "type": "text",
      "id": "target_day",
      "label": "Countdown Day (EST)",
      "info": "Enter day number (1-31)"
    },
    {
      "type": "text",
      "id": "target_hour",
      "label": "Countdown Hour (EST)",
      "info": "Enter hour (0-23, 24-hour format, e.g., 14 for 2 PM)"
    },
    {
      "type": "text",
      "id": "target_minute",
      "label": "Countdown Minute (EST)",
      "info": "Enter minute (0-59)"
    },
    {
      "type": "text",
      "id": "countdown_expired_text",
      "label": "Countdown Expired Text",
      "default": "Opening Soon."
    }
  ],
  "presets": [
    {
     "name": "Password page",
    }
  ]
}
{% endschema %}