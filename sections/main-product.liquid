{%- liquid
  assign has_content_below_gallery = false

  for block in section.blocks
    if block.type == 'complementary_products'
      assign has_content_below_gallery = true
      break
    endif

    unless block.settings.show_below_gallery
      continue
    endunless

    if block.type == 'accordion' and block.settings.title != blank and block.settings.content != blank or block.settings.liquid != blank or block.settings.page.content != blank
      assign has_content_below_gallery = true
      break
    elsif block.type == 'description' and product.description != blank
      assign has_content_below_gallery = true
      break
    endif
  endfor
-%}

<style>
  #shopify-section-{{ section.id }} {
    --product-grid: "product-gallery" "product-info" {% if has_content_below_gallery %}"product-content"{% endif %} / minmax(0, 1fr);
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      {%- if has_content_below_gallery -%}
        --product-grid: "product-gallery product-info" auto "product-content product-info" minmax(0, 1fr) / minmax(0, {{ 100.0 | minus: section.settings.product_info_size | divided_by: 100.0 }}fr) minmax(0, {{ section.settings.product_info_size | divided_by: 100.0 }}fr);
      {%- else -%}
        --product-grid: "product-gallery product-info" / minmax(0, {{ 100.0 | minus: section.settings.product_info_size | divided_by: 100.0 }}fr) minmax(0, {{ section.settings.product_info_size | divided_by: 100.0 }}fr);
      {%- endif -%}
    }
  }
</style>

{%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

<div class="section-spacing section-spacing--tight color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }}">
  <div class="container {% unless section.settings.container_size == 'full' %}container--{{ section.settings.container_size }}{% endunless %}">
    <div class="product">
      {%- if product.media.size > 0 -%}
        {%- render 'product-gallery',
            product: product,
            desktop_layout: section.settings.desktop_media_layout,
            mobile_controls: section.settings.mobile_controls,
            enable_media_autoplay: section.settings.enable_media_autoplay,
            enable_video_looping: section.settings.enable_video_looping,
            enable_image_zoom: section.settings.enable_image_zoom,
            max_image_zoom_level: section.settings.max_image_zoom_level -%}
      {%- endif -%}

      {%- render 'product-info', product: product, center_basic_info: section.settings.center_basic_info, has_content_below_gallery: has_content_below_gallery, update_url: true -%}

      {%- comment -%}On Prestige, some content may be on the left part below the product gallery{%- endcomment -%}
      {%- if has_content_below_gallery -%}
        <div id="product-extra-information" class="product-content-below-gallery empty:hidden scroll-margin-offset">
          {%- for block in section.blocks -%}
            {%- unless block.settings.show_below_gallery -%}
              {%- continue -%}
            {%- endunless -%}

            {%- case block.type -%}
              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  {%- if block.settings.collapse_content -%}
                    {%- assign accordion_title = 'product.general.description' | t -%}
                    {%- render 'accordion', title: accordion_title, content: product.description, prose_content: true, size: 'lg', block: block, show_arrow: true -%}
                  {%- else -%}
                    <div class="product-content-below-gallery__description prose">
                      {{- product.description -}}
                    </div>
                  {%- endif -%}
                {%- endif -%}

              {%- when 'accordion' -%}
                {%- liquid
                  assign accordion_title = block.settings.title | default: block.settings.page.title
                  assign accordion_content = block.settings.page.content | default: block.settings.liquid | default: block.settings.content

                  if accordion_title != blank and accordion_content != blank
                    render 'accordion', title: accordion_title, content: accordion_content, size: 'lg', prose_content: true, icon: block.settings.icon, custom_icon: block.settings.custom_icon, block: block,  show_arrow: true
                  endif
                -%}

              {%- when 'complementary_products' -%}
                {%- render 'complementary-products', product: product, block: block -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- if section.settings.show_sticky_add_to_cart and product.available -%}
  {%- capture form_id -%}product-form-{{ product.id }}-{{ section.id }}{%- endcapture -%}

  <product-sticky-bar form="{{ form_id }}" class="product-sticky-bar">
    <div class="product-sticky-bar__info sm-max:hidden">
      <div class="h-stack gap-6">
        {%- if product.media.size > 0 -%}
          <variant-media widths="60,120,180" form="{{ form_id }}">
            {%- assign default_media = product.selected_or_first_available_variant.media | default: product.featured_media -%}
            {{- default_media | image_url: width: default_media.width | image_tag: loading: 'lazy', sizes: '60px', widths: '60,120,180' -}}
          </variant-media>
        {%- endif -%}

        <div class="v-stack">
          <span class="h6">{{ product.title }}</span>
          {%- render 'price-list', variant: product.selected_or_first_available_variant, form_id: form_id, hide_unit_price: true, context: 'card' -%}
        </div>
      </div>
    </div>

    <buy-buttons class="buy-buttons" template="{{ product.template_suffix | escape }}" form="{{ form_id }}">
      {%- liquid
        assign button_disabled = false

        if product.selected_or_first_available_variant.available == false
          assign button_disabled = true
          assign button_content = 'product.general.sold_out_button' | t
        else
          if product.template_suffix contains 'pre-order'
            assign button_content = 'product.general.pre_order_button' | t
          else
            assign button_content = 'product.general.add_to_cart_button' | t
          endif
        endif
      -%}

      {%- render 'button', content: button_content, type: 'submit', form: form_id, disabled: button_disabled -%}
    </buy-buttons>
  </product-sticky-bar>
{%- endif -%}

{%- comment -%}
IMPLEMENTATION NOTE: Shopify does not currently allows to render a given section within the context of a given product. However,
when rendering the quick buy drawers/popovers, we want to be able to re-use the merchant's choices (such as the selector type). This
is however only possible by rendering the whole product page, and extracting the relevant part. Here, we therefore render the
quick buy information in a template, that will be extracted in JS, which ensures it is not visible in the main product page
{%- endcomment -%}
{%- render 'product-quick-buy', product: product -%}
{%- capture product_form_id -%}product-form-{{ product.id }}-{{ section.id }}{%- endcapture -%}

{% for block in section.blocks %}
  {% if block.type == 'size-chart' %}
{% render 'size-drawer', product_form_id: product_form_id, block: block %}
  {% endif %}
{% endfor %}

<script>
  // We save the product ID in local storage to be eventually used for recently viewed section
  try {
    let recentlyViewedProducts = JSON.parse(localStorage.getItem('theme:recently-viewed-products') || '[]');

    recentlyViewedProducts = recentlyViewedProducts.filter(item => item !== {{ product.id }}); // Delete product to remove to the start
    recentlyViewedProducts.unshift({{ product.id }}); // Add at the start

    localStorage.setItem('theme:recently-viewed-products', JSON.stringify(recentlyViewedProducts));
  } catch (e) {
    // Safari in private mode does not allow setting item, we silently fail
  }
</script>





{%- assign sticky_form_id = 'product-form-' | append: product.id | append: '-' | append: section.id | append: '-sticky' -%}

<div id="sticky-atc-{{ section.id }}" class="sticky-atc" aria-hidden="true">
  <div class="sticky-atc__inner container">
    <div class="sticky-atc__meta">
      <div class="sticky-atc__text">
        <div class="sticky-atc__title">{{ product.title }}</div>
        <div class="sticky-atc__price">{% render 'price-list', variant: product.selected_or_first_available_variant, form_id: sticky_form_id %}</div>
      </div>
      <div class="product-options-wrapper">
      {% if product.options_with_values.size > 0 %}
      {% for option in product.options_with_values %}
        <select id="Option{{ forloop.index0 }}"
                name="options[{{ option.name }}]"
                form="{{ sticky_form_id }}"
                class="sticky-product-option-select">
          {% for value in option.values %}
            <option value="{{ value }}"
              {% if option.selected_value == value %}selected{% endif %}>
              {{ value }}
            </option>
          {% endfor %}
        </select>
      {% endfor %}
    {% endif %}
  </div>
    </div>

    <div class="sticky-atc__controls">
      {%- render 'buy-buttons',
          product: product,
          form_id: sticky_form_id,
          show_payment_button: false,  /* usually cleaner in a compact bar; flip to true if you want */
          show_gift_card_recipient: block.settings.show_gift_card_recipient,
          atc_button_background: block.settings.atc_button_background,
          atc_button_text_color: block.settings.atc_button_text_color,
          payment_button_background: block.settings.payment_button_background,
          payment_button_text_color: block.settings.payment_button_text_color,
          btn_text:section.settings.btn_text
      -%}
    </div>
  </div>
</div>

<style>
  /* Sticky ATC */
.sticky-atc {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  background: #fff;
  border-top: 1px solid rgba(0,0,0,.08);
  box-shadow: 0 -6px 20px rgba(0,0,0,.08);
  transform: translateY(100%);
  transition: transform .25s ease, opacity .25s ease;
  opacity: 0;
  pointer-events: none;
}

.sticky-atc.is-visible {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.sticky-atc .container {
  max-width: var(--page-width, 1200px);
  margin: 0 auto;
  padding: 10px 16px;
}

.sticky-atc__inner {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: 16px;
}

.sticky-atc__meta {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 12px;
  align-items: center;
  min-width: 0;
}

.sticky-atc__thumb {
  width: 56px;
  height: 56px;
  object-fit: cover;
  border: 1px solid rgba(0,0,0,.06);
  border-radius: 4px;
}

.sticky-atc__title {
  font-size: 14px;
  font-weight: 600;
  line-height: 1.2;
  margin-bottom: 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sticky-atc__price {
  font-size: 13px;
  opacity: .8;
}

.sticky-atc__controls {
  display: flex;
  gap: 8px;
  align-items: center;
}

/* Keep the sticky button full-width on mobile */
@media (max-width: 768px) {
  .sticky-atc__inner {
    grid-template-columns: 1fr;
    gap: 10px;
  }
  .sticky-atc__controls > form,
  .sticky-atc__controls [type="submit"],
  .sticky-atc__controls .shopify-payment-button,
  .sticky-atc__controls .shopify-payment-button__button {
    width: 100%;
  }
}
@media screen and (max-width: 768px){
    .sticky-atc__meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
}

.sticky-atc__text {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}

.sticky-product-option-select {width: 100%;flex: 0 0 50%;}
}
.product-options-wrapper {
    display: grid;
    width: 100%;
    column-gap: 5px;
    grid-auto-columns: 1fr 1fr;
}

.sticky-product-option-select {
    border: 1px solid #aaa;
    background-color: white;
    padding: 5px 12px;
}


@media screen and (min-width: 768px){
    .sticky-product-option-select {
    max-width: 200px;
    min-width: 200px;
}

.product-options-wrapper {justify-items: end;}
}



/* Custom Changes */

/* Sticky ATC: custom select — scoped */
.sticky-atc .cs {
  position: relative;
  width: 100%;
  max-width: 200px; /* desktop matches your current select */
  font-size: 14px;
}
@media (max-width: 768px){
  .sticky-atc .cs { max-width: 100%; }
}

/* Hide the native select but keep it in the DOM for form submit & change events */
.sticky-atc .sticky-product-option-select.cs--hidden {
  position: absolute !important;
  inset: 0 auto auto 0 !important;
  width: 0 !important;
  height: 0 !important;
  opacity: 0 !important;
  pointer-events: none !important;
}

/* Trigger (closed face) */
.sticky-atc .cs__trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  width: 100%;
  padding: 10px 12px;
  border: 1px solid #e5e5e5;
  background: #fff;
  line-height: 1;
  cursor: pointer;
}

/* Chevron */
.sticky-atc .cs__chev {
  width: 16px;
  height: 16px;
  display: inline-block;
  transform: rotate(0);
  transition: transform .15s ease;
  border-right: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform-origin: 50% 45%;
}
.sticky-atc .cs--open .cs__chev { transform: rotate(-135deg); }

/* Dropdown panel */
.sticky-atc .cs__list {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 100%;
  max-height: 260px;
  overflow: auto;
  background: #fff;
  border: 1px solid #e5e5e5;
  {% comment %} box-shadow: 0 10px 24px rgba(0,0,0,.08); {% endcomment %}
  z-index: 999; /* above sticky bar */
  display: none;
}
.sticky-atc .cs--open .cs__list { display: block; }

/* Option rows */
.sticky-atc .cs__item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  cursor: pointer;
  border-bottom: 1px solid #e5e5e5;
}
.sticky-atc .cs__item:hover,
.sticky-atc .cs__item[aria-selected="true"] {
  background: #f6f6f6;
}

/* Small color chip (optional) */
.sticky-atc .cs__swatch {
  width: 14px;
  height: 14px;
  border-radius: 3px;
  border: 1px solid rgba(0,0,0,.15);
  flex: 0 0 14px;
}

/* Text clamp */
.sticky-atc .cs__label {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sticky-atc .cs__chev {
    transform: rotate(45deg);
    width: 10px;
    height: 10px;
}

.sticky-atc .cs__trigger {
    padding: 0;
}

.sticky-atc .cs__trigger .cs__label {
    display: block;
    padding: 10px 12px;
    width: 100%;
    text-align: left;
}

.sticky-atc span.cs__chev-warpper {
    display: block;
    padding: 10px 12px;
    border-left: 1px solid #e5e5e5;
}
</style>

<script>
(function() {
  const sectionId = '{{ section.id }}';
  const sticky = document.getElementById(`sticky-atc-${sectionId}`);
  const sticky_height = sticky.innerHeight;
  const body = document.querySelector(`body`);
  if (!sticky) return;

  const mainBuyButtons = document.querySelector('[data-main-buy-buttons]');
  if (!mainBuyButtons) return;

  const mainForm = document.getElementById('{{ product_form_id }}');
  const stickyForm = document.getElementById('{{ sticky_form_id }}');

  // REPLACE this function
const onIntersect = (entries) => {
  const entry = entries[0];
  if (!entry) return;

  // Show sticky ONLY after the main ATC's bottom is above the viewport
  const passed = entry.boundingClientRect.bottom <= 0;

  body.classList.toggle('sticky-is-visible', passed);
  sticky.classList.toggle('is-visible', passed);
  sticky.setAttribute('aria-hidden', passed ? 'false' : 'true');
  
};

  // IntersectionObserver with a small root margin so it appears a tad early
  const io = ('IntersectionObserver' in window)
    ? new IntersectionObserver(onIntersect, { root: null, threshold: 0, rootMargin: '0px 0px -10% 0px' })
    : null;

  if (io) {
    io.observe(mainBuyButtons);
  } else {
    // Fallback: simple scroll check (older browsers)
    const check = () => {
    const rect = mainBuyButtons.getBoundingClientRect();
    // Passed when the main ATC's bottom edge is above the viewport top
    const passed = rect.bottom <= 0;

    sticky.classList.toggle('is-visible', passed);
    sticky.setAttribute('aria-hidden', passed ? 'false' : 'true');
    console.log(sticky_height);
  };
    window.addEventListener('scroll', check, { passive: true });
    window.addEventListener('resize', check);
    check();
  }



  const product = {{ product | json }};
  const idInput = stickyForm.querySelector('input[name="id"]');

  const selects = document.querySelectorAll(".sticky-atc .sticky-product-option-select");

  /* -------- Custom select enhancement (only styling/UX) -------- */
  // Optional: map color names to chips for a nicer look in the color dropdown.
  // Extend as needed; unmatched names simply show no swatch.
  const COLOR_MAP = {
    "Black": "#000000",
    "White": "#FFFFFF",
    "Pristine": "#F5F5F2",
    "Pine Grove": "#0D3B3C",
    "Equestrian Red": "#B10011",
    "Navy": "#112233",
    "Blue": "#1E88E5",
    "Green": "#2E7D32",
    "Red": "#D32F2F",
    "Beige": "#DDC9A3"
  };

  function buildCustomSelect(nativeSelect) {
    nativeSelect.classList.add('cs--hidden'); // hide native (via CSS)

    const wrap = document.createElement('div');
    wrap.className = 'cs';
    nativeSelect.parentNode.insertBefore(wrap, nativeSelect);
    wrap.appendChild(nativeSelect); // keep it inside for form scope

    const trigger = document.createElement('button');
    trigger.type = 'button';
    trigger.className = 'cs__trigger';
    trigger.setAttribute('aria-haspopup', 'listbox');
    trigger.setAttribute('aria-expanded', 'false');

    const trigLabel = document.createElement('span');
    trigLabel.className = 'cs__label';
    trigLabel.textContent = nativeSelect.options[nativeSelect.selectedIndex]?.text || nativeSelect.getAttribute('placeholder') || 'Select option';

    const chevWrapper = document.createElement('span');
    const chev = document.createElement('i');
    chev.className = 'cs__chev';
    chevWrapper.className = 'cs__chev-warpper';
    chevWrapper.appendChild(chev);

    trigger.appendChild(trigLabel);
    trigger.appendChild(chevWrapper);

    const list = document.createElement('div');
    list.className = 'cs__list';
    list.setAttribute('role', 'listbox');
    list.setAttribute('tabindex', '-1');

    // Build items from options
    Array.from(nativeSelect.options).forEach((opt, idx) => {
      const item = document.createElement('div');
      item.className = 'cs__item';
      item.setAttribute('role', 'option');
      item.setAttribute('data-value', opt.value);
      if (opt.selected) item.setAttribute('aria-selected', 'true');

      // Optional color swatch if COLOR_MAP has a match (by exact case-insensitive name)
      const swatch = document.createElement('span');
      swatch.className = 'cs__swatch';
      const colorHex = COLOR_MAP[opt.text.trim()] || null;
      if (colorHex) swatch.style.background = colorHex; else swatch.style.display = 'none';

      const label = document.createElement('span');
      label.className = 'cs__label';
      label.textContent = opt.text;

      item.appendChild(swatch);
      item.appendChild(label);

      // Click to select
      item.addEventListener('click', () => {
        // Update native select
        nativeSelect.value = opt.value;
        // reflect UI
        list.querySelectorAll('.cs__item[aria-selected="true"]').forEach(el => el.removeAttribute('aria-selected'));
        item.setAttribute('aria-selected', 'true');
        trigLabel.textContent = opt.text;

        // Dispatch change so your updateVariantId() runs
        nativeSelect.dispatchEvent(new Event('change', { bubbles: true }));
        close();
      });

      list.appendChild(item);
    });

    // Open/close behavior
    function open() {
      wrap.classList.add('cs--open');
      trigger.setAttribute('aria-expanded', 'true');
      list.focus({ preventScroll: true });
    }
    function close() {
      wrap.classList.remove('cs--open');
      trigger.setAttribute('aria-expanded', 'false');
    }

    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      if (wrap.classList.contains('cs--open')) close(); else open();
    });

    document.addEventListener('click', (e) => {
      if (!wrap.contains(e.target)) close();
    });

    // Basic keyboard support
    list.addEventListener('keydown', (e) => {
      const items = Array.from(list.querySelectorAll('.cs__item'));
      const current = items.findIndex(i => i.getAttribute('aria-selected') === 'true');
      if (e.key === 'Escape') { e.preventDefault(); close(); trigger.focus(); }
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        const next = items[Math.min(current + 1, items.length - 1)] || items[0];
        next.scrollIntoView({ block: 'nearest' });
        next.click();
      }
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        const prev = items[Math.max(current - 1, 0)] || items[0];
        prev.scrollIntoView({ block: 'nearest' });
        prev.click();
      }
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        items[Math.max(current, 0)]?.click();
      }
    });

    wrap.appendChild(trigger);
    wrap.appendChild(list);
    return { wrap, trigger, list, trigLabel };
  }

  // Enhance each sticky select
  selects.forEach(sel => buildCustomSelect(sel));

  /* -------- end: custom select enhancement -------- */

  function updateVariantId() {
    const selectedOptions = Array.from(selects).map(sel => sel.value);
    const matchedVariant = product.variants.find(variant => {
      return JSON.stringify(variant.options) === JSON.stringify(selectedOptions);
    });

    if (matchedVariant) {
      idInput.value = matchedVariant.id;

      const submit = stickyForm.querySelector('[type="submit"]');
      if (submit) {
        submit.disabled = !matchedVariant.available;
        submit.textContent = matchedVariant.available ? "Add to Bag" : "Sold Out";
      }
    }
  }

  // Keep your original binding: when native select changes (via our custom UI), updateVariantId runs
  selects.forEach(sel => sel.addEventListener("change", updateVariantId));


  
})();
</script>


{% schema %}
{
  "name": "t:sections.main_product.name",
  "class": "shopify-section--main-product",
  "tag": "section",
  "settings": [
    {
      "type":"text",
      "label":"Sticky ADd to cart text",
      "id":"btn_text",
      "default":"Add to Bag"
    },
   {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "container_size",
      "label": "t:global.sizes.section_width",
      "options": [
        {
          "value": "lg",
          "label": "t:global.sizes.large"
        },
        {
          "value": "xl",
          "label": "t:global.sizes.x_large"
        },
        {
          "value": "full",
          "label": "t:global.sizes.full_width"
        }
      ],
      "default": "lg"
    },
    {
      "type": "range",
      "id": "product_info_size",
      "label": "t:sections.main_product.product_info_size",
      "info": "t:sections.main_product.product_info_size_info",
      "min": 30,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 35
    },
    {
      "type": "checkbox",
      "id": "show_sticky_add_to_cart",
      "label": "t:sections.main_product.show_sticky_add_to_cart",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "center_basic_info",
      "label": "t:sections.main_product.center_basic_info",
      "info": "t:sections.main_product.center_basic_info_info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.main_product.media_category",
      "info": "t:sections.main_product.media_category_info"
