{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    background-color: {{ section.settings.background_color }};
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  .stacked-content-container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    width: 100%;
  }

  /* Block Specific Styles */
  .stacked-text-block {
    padding-top: var(--pt-mobile);
    padding-bottom: var(--pb-mobile);
    padding-left: 20px;
    padding-right: 20px;
  }

  .stacked-text-block h2 {
    font-size: var(--h-size-mobile);
    color: var(--text-color);
    margin-top: 0;
    margin-bottom: 20px;
    text-decoration: var(--h-decoration);
    text-underline-offset: 6px;
    text-align: var(--h-align); /* NEW: Heading alignment variable */
  }

  .stacked-text-block .rte-content {
    font-size: var(--t-size-mobile);
    color: var(--text-color);
    line-height: 1.6;
    max-width: 800px;
    margin: 0 auto;
    text-align: var(--t-align); /* NEW: Text alignment variable */
  }

  .stacked-text-block .rte-content p {
    margin-bottom: 15px;
  }

  .stacked-image-block {
    padding-top: var(--pt-mobile);
    padding-bottom: var(--pb-mobile);
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .stacked-image-block img, 
  .stacked-image-block svg {
    max-width: 100%;
    height: auto;
    display: block;
    width: 100%;
    object-fit: cover;
  }

  @media screen and (min-width: 768px) {
    .stacked-text-block {
      padding-top: var(--pt-desktop);
      padding-bottom: var(--pb-desktop);
    }
    
    .stacked-text-block h2 {
      font-size: var(--h-size-desktop);
    }
    
    .stacked-text-block .rte-content {
      font-size: var(--t-size-desktop);
    }

    .stacked-image-block {
      padding-top: var(--pt-desktop);
      padding-bottom: var(--pb-desktop);
    }
  }

  .stacked-text-block .rte-content :where(h1,h2,h3,h4,h5,h6) {
    margin-bottom: 10px;
}
{%- endstyle -%}

<div class="stacked-content-section section-{{ section.id }}-padding">
  <div class="stacked-content-container">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        
        {%- when 'text' -%}
          <div class="stacked-text-block" {{ block.shopify_attributes }} style="
            --pt-desktop: {{ block.settings.padding_top_desktop }}px;
            --pb-desktop: {{ block.settings.padding_bottom_desktop }}px;
            --pt-mobile: {{ block.settings.padding_top_mobile }}px;
            --pb-mobile: {{ block.settings.padding_bottom_mobile }}px;
            --h-size-desktop: {{ block.settings.heading_size_desktop }}px;
            --h-size-mobile: {{ block.settings.heading_size_mobile }}px;
            --t-size-desktop: {{ block.settings.text_size_desktop }}px;
            --t-size-mobile: {{ block.settings.text_size_mobile }}px;
            --text-color: {{ block.settings.text_color }};
            --h-decoration: {% if block.settings.underline_heading %}underline{% else %}none{% endif %};
            --h-align: {{ block.settings.heading_alignment }};
            --t-align: {{ block.settings.text_alignment }};
          ">
            {%- if block.settings.heading != blank -%}
              <h2>{{ block.settings.heading }}</h2>
            {%- endif -%}
            
            {%- if block.settings.text != blank -%}
              <div class="rte-content">
                {{ block.settings.text }}
              </div>
            {%- endif -%}
          </div>
        {% when 'hr' %}
          <hr style="margin-top: {{ block.settings.margin_top }}px;margin-bottom: {{ block.settings.margin_bottom }}px;border-color: {{ block.settings.clr }};margin-left: 20px;margin-right: 20px;">

        {%- when 'image' -%}
          <div class="stacked-image-block" {{ block.shopify_attributes }} style="
            --pt-desktop: {{ block.settings.padding_top_desktop }}px;
            --pb-desktop: {{ block.settings.padding_bottom_desktop }}px;
            --pt-mobile: {{ block.settings.padding_top_mobile }}px;
            --pb-mobile: {{ block.settings.padding_bottom_mobile }}px;
          ">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', alt: block.settings.image.alt | escape }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>

      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

