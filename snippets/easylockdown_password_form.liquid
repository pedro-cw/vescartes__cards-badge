{% comment %}
  Custom EasyLockdown password form — exact mirror of main-password.liquid
  with EasyLockdown's JS unlock mechanism instead of Shopify's native /password POST.
{% endcomment %}

<div id="easylockdown-password-form" style="display: none;">
  <div class="pw-page">
    <style>
      #easylockdown-password-form {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 99999;
        background: #000000;
        overflow-y: auto;
      }

      html,
      body {
        height: 100%;
        overflow-x: hidden;
        background: #000000;
        margin: 0;
        padding: 0;
        position: fixed;
        width: 100%;
      }

      body {
        margin: 0;
        padding: 0;
        background: #000000;
        color: #ffffff;
        font-family: 'Helvetica Neue', sans-serif;
        height: 100vh;
      }

      .pw-page {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 40px 20px;
        box-sizing: border-box;
        position: relative;
        background: #000000;
      }

      .pw-stack {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        width: 100%;
        max-width: 500px;
        margin: 0 auto;
        padding: 20px;
      }

      .pw-page__logo {
        margin-bottom: 40px;
      }

      .pw-page__logo img {
        height: auto;
        width: 100%;
        max-width: 100%;
      }

      .password-button {
        position: fixed;
        top: 20px;
        right: 20px;
        background: #181a1b;
        color: #a1a1a1;
        border: none;
        padding: 10px 20px;
        cursor: pointer;
        font-family: 'Helvetica Neue', sans-serif;
        z-index: 100;
      }

      .password-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;
        justify-content: center;
        align-items: center;
      }

      .password-modal.active {
        display: flex;
      }

      .modal-content {
        background: #1a1a1a;
        color: #ffffff;
        padding: 30px;
        border-radius: 4px;
        width: 90%;
        max-width: 400px;
        position: relative;
      }

      .close-modal {
        position: absolute;
        right: 10px;
        top: 10px;
        background: none;
        border: none;
        font-size: 24px;
        cursor: pointer;
        color: #ffffff;
      }

      .password-form {
        display: flex;
        flex-direction: column;
        gap: 15px;
      }

      .password-form input[type='password'] {
        font-size: 16px;
        padding: 10px;
        border: 1px solid #ffffff;
        width: 100%;
        background: #1a1a1a;
        color: #a1a1a1;
      }

      .password-form-submit {
        background: #ffffff;
        color: #000000;
        border: none;
        padding: 12px;
        cursor: pointer;
        font-family: 'Helvetica Neue', sans-serif;
        font-weight: 700;
        width: 100%;
        text-decoration: none;
        text-align: center;
        display: block;
      }

      #easylockdown-password-error {
        display: none;
        color: #e32c2b;
        margin-bottom: 5px;
      }

      #countdown {
        display: flex;
        justify-content: center;
        gap: 20px;
        text-align: center;
        margin: 0px 0;
        width: 100%;
        padding-bottom: 25px;
      }

      div#countdown.expired {
        color: rgb(252, 250, 250);
        font-size: 20px;
        font-family: Helvetica, Arial, sans-serif;
        font-weight: 400;
        font-style: normal;
        max-width: 400px;
        flex-wrap: wrap;
        text-wrap-style: pretty;
      }

      span.expired-text {
        font-weight: 700;
        font-style: normal;
      }

      .support-links {
        flex-direction: column;
        display: flex;
        font-size: 18px;
      }

      .time-unit {
        min-width: 65px;
        display: flex;
        flex-direction: column;
        align-items: center;
        line-height: 1.1;
      }

      .time-value {
        font-size: 3.5em;
        font-weight: 400;
        display: block;
        font-family: 'Helvetica Neue', sans-serif;
        color: #ffffff;
        letter-spacing: 0.1em;
      }

      .time-label {
        font-size: 1.1em;
        text-transform: uppercase;
        color: #cccccc;
        font-family: 'Helvetica Neue', sans-serif;
        margin-top: 5px;
      }

      .klaviyo-form-section {
        width: 100%;
        max-width: 400px;
        margin: 20px auto;
        padding: 20px;
      }

      .klaviyo-form-section iframe {
        max-width: 100% !important;
      }

      .password-description {
        color: #ffffff;
        font-family: 'Helvetica Neue', sans-serif;
        font-weight: 400;
        font-style: normal;
        font-size: 1.1em;
        margin: 20px 0;
        max-width: 600px;
      }

      @media (max-width: 480px) {
        .pw-stack {
          padding: 10px;
        }

        .klaviyo-form-section {
          padding: 10px;
        }

        #countdown {
          gap: 10px;
        }

        .time-value {
          font-size: 2.8em;
        }

        .time-label {
          font-size: 1em;
        }
      }

      .pw-page * {
        font-family: var(--text-font-family) !important;
      }
    </style>

    <button type="button" class="password-button" id="openPasswordModal">ENTER PASSWORD</button>

    <div class="password-modal" id="passwordModal">
      <div class="modal-content">
        <button type="button" class="close-modal" id="closePasswordModal">&times;</button>
        <div class="password-form">
          <div id="easylockdown-password-error">Invalid password</div>
          <input type="password" placeholder="{{ easylockdownPasswordPlaceholder }}" id="easylockdown-password"
                 onkeypress="if( event.keyCode == 13 && typeof easylockdown == 'object' && typeof easylockdown.checkUnlockPassword == 'function' ) { event.preventDefault(); easylockdown.checkUnlockPassword(this); }" />
          <a href="javascript:void(0);" class="password-form-submit" id="easylockdown-password-form-button" onclick="if( typeof easylockdown == 'object' && typeof easylockdown.checkUnlockPassword == 'function' ) easylockdown.checkUnlockPassword(this);">ENTER</a>
        </div>
      </div>
    </div>

    <div class="pw-stack">
      {%- if settings.nextlaunch_logo != blank -%}
        <div class="pw-page__logo">
          <img
            src="{{ settings.nextlaunch_logo | image_url: width: 2000 }}"
            alt="{{ shop.name }}"
            loading="lazy"
          >
        </div>
      {%- else -%}
        <div class="pw-page__logo">
          <img
            src="{{ 'VESCARTES_CURSIVE_3.png' | file_img_url: '2000x' }}"
            alt="{{ shop.name }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}

      <div id="countdown">
        <div class="time-unit">
          <span id="days" class="time-value"></span>
          <span class="time-label">days</span>
        </div>
        <div class="time-unit">
          <span id="hours" class="time-value"></span>
          <span class="time-label">hours</span>
        </div>
        <div class="time-unit">
          <span id="minutes" class="time-value"></span>
          <span class="time-label">minutes</span>
        </div>
        <div class="time-unit">
          <span id="seconds" class="time-value"></span>
          <span class="time-label">seconds</span>
        </div>
      </div>

      <div class="klaviyo-form-section">
        {% if localization.market.handle == 'gb' %}
          <div class="klaviyo-form-VaNNW4"></div>
        {% elsif localization.market.handle == 'usa' %}
          <div class="klaviyo-form-S2J7pL"></div>
        {% else %}
          <div class="klaviyo-form-XDkw2v"></div>
        {% endif %}

        <script>
          document.addEventListener('DOMContentLoaded', function () {
            var event = new Event('mousemove');
            document.dispatchEvent(event);
          });
        </script>
      </div>
    </div>
  </div>

  <script>
    (function() {
      /* Password modal */
      var modal = document.getElementById('passwordModal');
      var openBtn = document.getElementById('openPasswordModal');
      var closeBtn = document.getElementById('closePasswordModal');

      if (openBtn && modal) {
        openBtn.addEventListener('click', function() { modal.classList.add('active'); });
      }
      if (closeBtn && modal) {
        closeBtn.addEventListener('click', function() { modal.classList.remove('active'); });
      }
      if (modal) {
        modal.addEventListener('click', function(e) {
          if (e.target === modal) modal.classList.remove('active');
        });
      }

      /* Countdown — reads from shared theme settings */
      var targetMonth = "{{ settings.nextlaunch_target_month | default: '' }}";
      var targetDay = "{{ settings.nextlaunch_target_day | default: '' }}";
      var targetHour = "{{ settings.nextlaunch_target_hour | default: '' }}";
      var targetMinute = "{{ settings.nextlaunch_target_minute | default: '' }}";

      var countdownEl = document.getElementById('countdown');
      var daysEl = document.getElementById('days');
      var hoursEl = document.getElementById('hours');
      var minutesEl = document.getElementById('minutes');
      var secondsEl = document.getElementById('seconds');

      if (!targetMonth || !targetDay || !targetHour || !targetMinute) {
        if (countdownEl) countdownEl.style.display = 'none';
        return;
      }

      var currentYear = new Date().getFullYear();
      var paddedMonth = targetMonth.padStart(2, '0');
      var paddedDay = targetDay.padStart(2, '0');
      var paddedHour = targetHour.padStart(2, '0');
      var paddedMinute = targetMinute.padStart(2, '0');
      var targetDateString = currentYear + '-' + paddedMonth + '-' + paddedDay + 'T' + paddedHour + ':' + paddedMinute + ':00-05:00';
      var targetDateEST = new Date(targetDateString);

      if (isNaN(targetDateEST.getTime())) {
        countdownEl.innerHTML = 'Countdown timer configuration error.';
        return;
      }

      function update() {
        var diff = targetDateEST.getTime() - Date.now();
        if (diff <= 0) {
          countdownEl.innerHTML = '<span class="expired-text">{{ settings.nextlaunch_countdown_expired_text | default: "Launched!" }}</span><div class="support-links"><a href="https://vescartesupdates.com">tracking: <span style="text-decoration: underline">vescartesupdates.com</span></a><span>support: contact@vescartes.com</span></div>';
          countdownEl.classList.add('expired');
          clearInterval(timer);
          return;
        }
        daysEl.textContent = Math.floor(diff / 86400000);
        hoursEl.textContent = String(Math.floor((diff % 86400000) / 3600000)).padStart(2, '0');
        minutesEl.textContent = String(Math.floor((diff % 3600000) / 60000)).padStart(2, '0');
        secondsEl.textContent = String(Math.floor((diff % 60000) / 1000)).padStart(2, '0');
      }

      var timer = setInterval(update, 1000);
      update();
    })();
  </script>
</div>
