<script>
(function() {
  const bar = document.getElementById('promo-bar');
  const timerSpan = document.getElementById('promo-timer');

  const EXPIRY_KEY = 'promo_offer_expiry';
  const SHOWN_KEY = 'promo_offer_shown';
  const SESSION_KEY = 'promo_offer_session_active';

  // 👇 Change this to your banner section class
  const bannerSelector = '.timer-banner';
  const bannerSection = document.querySelector(bannerSelector);

  function hideEverything() {
    if (bar) bar.style.display = 'none';
    if (bannerSection) bannerSection.style.display = 'none';
  }

  function formatTime(ms) {
    const totalSeconds = Math.floor(ms / 1000);
    const minutes = Math.floor(totalSeconds / 60).toString().padStart(2, '0');
    const seconds = (totalSeconds % 60).toString().padStart(2, '0');
    return `${minutes}:${seconds}`;
  }

  function startCountdown(expiryTime) {
    const interval = setInterval(() => {
      const remaining = expiryTime - Date.now();
      if (remaining <= 0) {
        clearInterval(interval);
        localStorage.setItem(SHOWN_KEY, 'true');
        hideEverything();
      } else {
        timerSpan.textContent = formatTime(remaining);
      }
    }, 1000);
  }

  function initPromo() {
    const now = Date.now();
    const savedExpiry = parseInt(localStorage.getItem(EXPIRY_KEY), 10);
    const alreadyShown = localStorage.getItem(SHOWN_KEY) === 'true';
    const inCurrentSession = sessionStorage.getItem(SESSION_KEY) === 'true';

    // ✅ If offer already fully used, never show again
    if (alreadyShown) {
      hideEverything();
      return;
    }

    // ✅ If session exists and timer is valid → show bar (refresh case)
    if (inCurrentSession && savedExpiry && now < savedExpiry) {
      bar.style.display = 'flex';
      if (bannerSection) bannerSection.style.display = 'flex';
      startCountdown(savedExpiry);
      return;
    }

    // ✅ First ever visit (new session, no expiry set)
    if (!savedExpiry) {
      const newExpiry = now + 30 * 60 * 1000; // 30 minutes
      localStorage.setItem(EXPIRY_KEY, newExpiry);
      sessionStorage.setItem(SESSION_KEY, 'true');
      bar.style.display = 'flex';
      if (bannerSection) bannerSection.style.display = 'flex';
      startCountdown(newExpiry);
      return;
    }

    // ❌ If new visit (no session key), but expiry exists → do NOT show
    if (!inCurrentSession && savedExpiry && now < savedExpiry) {
      hideEverything(); // second visit — do not resume
      return;
    }

    // ❌ Expired offer
    hideEverything();
  }

  document.addEventListener('DOMContentLoaded', initPromo);
})();
</script>
