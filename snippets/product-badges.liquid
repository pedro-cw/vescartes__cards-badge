{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
PRODUCT BADGES COMPONENT
----------------------------------------------------------------------------------------------------------------------

This component is used in product listing and product page to render the badges of a given product

********************************************
Supported variables
********************************************

* product: the product to render the badges
* variant: the specific variant to show the badge from
* vertical: if set to true, the badges are outputted vertically
* types: the types of badge to output. Can be "custom", "sold_out", "discount" or "card_status" (or a combination separated by comma). If nothing is set, all badges are outputted.
* form_id: an optional form ID to use to update the badges when a given variant changes
{%- endcomment -%}

{%- liquid
  assign badge_types = types | default: 'custom, sold_out, discount' | split: ','
  assign variant = variant | default: product.selected_or_first_available_variant
-%}

{%- assign is_badge_list_hidden = true -%}

{%- capture badges -%}
  {%- for badge_type in badge_types -%}
    {%- assign stripped_badge_type = badge_type | strip -%}

    {%- case stripped_badge_type -%}
      {%- when 'custom' -%}
        {%- assign custom_badges = product.metafields.custom.badges.value -%}

        {%- for custom_badge in custom_badges -%}
          {%- assign is_badge_list_hidden = false -%}
          <span class="badge badge--custom badge--{{ custom_badge | handle }}">{{ custom_badge }}</span>
        {%- endfor -%}

      {%- when 'sold_out' -%}
        {%- if settings.show_sold_out_badge -%}
          {%- if variant.available == false or form_id != blank -%}
            {%- unless variant.available -%}
              {%- assign is_badge_list_hidden = false -%}
            {%- endunless -%}

            <sold-out-badge {% if variant.available %}hidden{% endif %} {% if form_id != blank %}form="{{ form_id }}"{% endif %} class="badge badge--sold-out">
              {{- 'product.general.sold_out_badge' | t -}}
            </sold-out-badge>
          {%- endif -%}
        {%- endif -%}

      {%- when 'discount' -%}
        {%- if settings.show_discount -%}
          {%- assign is_variant_on_sale = false -%}

          {%- if variant.compare_at_price > variant.price -%}
            {%- assign is_variant_on_sale = true -%}
            {%- assign is_badge_list_hidden = false -%}
          {%- endif -%}

          {%- if product.compare_at_price > product.price -%}
            {%- if settings.discount_mode == 'percentage' -%}
              {%- assign savings = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round | append: '%' -%}
            {%- else -%}
              {%- capture savings -%}{{ variant.compare_at_price | minus: variant.price | money }}{%- endcapture -%}
            {%- endif -%}

            <on-sale-badge {% if form_id != blank and is_variant_on_sale == false %}hidden{% endif %} {% if settings.show_discount %}discount-mode="{{ settings.discount_mode | escape }}"{% endif %} {% if form_id != blank %}form="{{ form_id }}"{% endif %} class="badge badge--on-sale">
              {%- if form_id == blank and is_variant_on_sale == false or product.compare_at_price_varies -%}
                {{- 'product.general.on_sale_badge' | t -}}
              {%- else -%}
                {{- 'product.general.discount_badge_html' | t: savings: savings -}}
              {%- endif -%}
            </on-sale-badge>
          {%- endif -%}
        {%- endif -%}

      {%- when 'card_status' -%}
        {%- comment -%}
          ------------------------------------------------------------------------------
          CARD STATUS (A/B test)
          ------------------------------------------------------------------------------
          Badge group used on the product cards of the collection grids. Every badge that
          applies is rendered, stacked in this order:

            1. Pre-order    -> custom.card_badge metafield
            2. Sold out     -> same condition the theme already used
            3. Low stock    -> fewer than `low_stock_threshold` units in stock
            4. Best selling -> custom.card_badge metafield
            5. New in       -> custom.card_badge metafield

          Sold out is the one exception to the stacking: it is skipped when the product is
          flagged as pre-order, since a pre-order product is out of stock by nature and
          "Pre-Order" is the badge that should speak for it.

          The legacy badges of the theme (sold out, custom, discount) keep rendering next
          to these, and are hidden by the A/B test CSS — that way the control variant is
          exactly the card that is live today.
        {%- endcomment -%}
        {%- liquid
          assign low_stock_threshold = 50

          assign card_badge_metafield = product.metafields.custom.card_badge

          # The metafield is a list, so its values are joined before being matched. The
          # single value type is handled too, in case it ever gets switched back.
          if card_badge_metafield.type contains 'list.'
            assign card_badge_value = card_badge_metafield.value | join: ','
          else
            assign card_badge_value = card_badge_metafield.value
          endif

          # Normalized so the metafield accepts "New in", "new-in", "new_in"...
          assign card_badge_value = card_badge_value | downcase | replace: '-', '' | replace: '_', '' | replace: ' ', ''

          # Liquid has no product-wide inventory count, so it is summed by variant.
          # Only variants whose inventory is actually tracked take part, otherwise
          # untracked products (quantity 0) would all look like low stock.
          assign card_inventory_quantity = 0
          assign card_inventory_tracked = false

          for card_variant in product.variants
            if card_variant.inventory_management != blank
              assign card_inventory_tracked = true

              if card_variant.inventory_quantity > 0
                assign card_inventory_quantity = card_inventory_quantity | plus: card_variant.inventory_quantity
              endif
            endif
          endfor

          assign card_is_pre_order = false

          if card_badge_value contains 'preorder'
            assign card_is_pre_order = true
          endif

          assign card_statuses = ''

          if card_is_pre_order
            assign card_statuses = card_statuses | append: 'pre-order,'
          endif

          if variant.available == false and settings.show_sold_out_badge and card_is_pre_order == false
            assign card_statuses = card_statuses | append: 'sold-out,'
          endif

          if card_inventory_tracked and card_inventory_quantity > 0 and card_inventory_quantity < low_stock_threshold
            assign card_statuses = card_statuses | append: 'low-stock,'
          endif

          if card_badge_value contains 'bestselling'
            assign card_statuses = card_statuses | append: 'best-selling,'
          endif

          if card_badge_value contains 'newin'
            assign card_statuses = card_statuses | append: 'new-in,'
          endif

          assign card_statuses = card_statuses | split: ','

          if card_statuses.size > 0
            assign is_badge_list_hidden = false
          endif
        -%}

        {%- for card_status in card_statuses -%}
          {%- case card_status -%}
            {%- when 'pre-order' -%}
              <span class="card-badge card-badge--pre-order">Pre-Order</span>

            {%- when 'sold-out' -%}
              <span class="card-badge card-badge--sold-out">{{ 'product.general.sold_out_badge' | t }}</span>

            {%- when 'low-stock' -%}
              <span class="card-badge card-badge--low-stock">Low Stock</span>

            {%- when 'best-selling' -%}
              <span class="card-badge card-badge--best-selling">Best Selling</span>

            {%- when 'new-in' -%}
              <span class="card-badge card-badge--new-in">New In</span>
          {%- endcase -%}
        {%- endfor -%}

    {%- endcase -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if badges != blank -%}
  <badge-list {% if form_id != blank and is_badge_list_hidden %}hidden{% endif %} class="badge-list {% if vertical %}badge-list--vertical{% endif %}">
    {{- badges -}}
  </badge-list>
{%- endif -%}