    "customer_reviews": {
      "type": "customer-reviews",
      "blocks": {
        "review_1": {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Compliment Magnet",
            "text": "Ordered from them twice now. Once back in November and again in May. I have bought a total of 4 jeans from them and they are all beautiful and of excellent quality. Have received multiple compliments from all sorts of people when wearing them, they are a big hit.",
            "name": "Joshua S",
            "initials": "JS"
          }
        },
        "review_2": {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Excellent after sale service",
            "text": "Excellent after sale service! I ordered a jacket in size S, it was actually too small. So I contacted the company to find out how to send it back. They sent me all the necessary information and refunded me the total amount I had paid initially!",
            "name": "Aurelian E",
            "initials": "AE"
          }
        },
        "review_3": {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "I’m completely in love",
            "text": "I’m completely in love with my Brazilian jersey! Honestly, I don’t think I’ve ever received so many compliments on an outfit in my life, haha! The quality is outstanding. It’s absolutely beautiful and incredibly well made.",
            "name": "Lidia I",
            "initials": "LI"
          }
        },
        "review_4": {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Cherry Blossom Denim Review",
            "text": "Wanted to wait until the weather was nice out to wear them. They fit amazingly and the quality of the embroidery is like no other! Vescartes makes some of the most high quality pieces I’ve ever purchased. 10/10 highly recommend",
            "name": "Victor F",
            "initials": "VF"
          }
        },
        "review_5": {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Vescartes Rocks!",
            "text": "Best clothing brand out right now!! Anytime I buy clothes from Vescartes it is guaranteed quality clothing. Ordering was easy and my package got to me in about a week and was handed to me by the delivery driver.",
            "name": "Chris H",
            "initials": "CH"
          }
        },
        "review_6": {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "5/5 Stars",
            "text": "Really impressed with the Last Supper jacket from Vescartes. The embroidery detail is high quality and you can tell it’s not just printed. It’s a unique piece that carries meaning, not just fashion. Fits well and feels premium, definitely worth it.",
            "name": "Akintola O",
            "initials": "AO"
          }
        }
      },
