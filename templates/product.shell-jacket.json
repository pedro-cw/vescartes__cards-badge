    "new_faq_rxVgpn": {
      "type": "new-faq",
      "blocks": {
        "faq_nfLm9F": {
          "type": "faq",
          "settings": {
            "question": "How does this item fit?",
            "answer": "<p>Each product page includes item-specific fit guidance, detailed measurements and model information. We recommend checking the Size Chart or using our size finder to find the best fit for you.</p>"
          }
        },
        "faq_6kwU9J": {
          "type": "faq",
          "settings": {
            "question": "When will my order arrive?",
            "answer": "<p>Orders are dispatched on the next working day and typically delivered within 5–12 working days, depending on your location. Once dispatched, you’ll receive a confirmation email with your tracking number.</p>"
          }
        },
        "faq_zzj36C": {
          "type": "faq",
          "settings": {
            "question": "Will I have to pay customs or import duties?",
            "answer": "<p>No. All applicable customs duties and taxes are prepaid and included in the final price, so there should be no additional charges upon delivery.</p>"
          }
        },
        "faq_L8zDLg": {
          "type": "faq",
          "settings": {
            "question": "Can I return the item if the size isn't right?",
            "answer": "<p>Yes. Returns can be requested within 14 days of delivery. Items must be unworn, unused and returned in their original packaging. Return shipping for sizing-related returns is the customer’s responsibility, and the parcel must be sent using tracked delivery.</p>"
          }
        },
        "faq_jWWPct": {
          "type": "faq",
          "settings": {
            "question": "How should I care for this piece?",
            "answer": "<p>Always follow the care instructions provided on the garment. To protect embroidery and printed artwork, turn the item inside out before washing, avoid high temperatures and do not iron directly over the artwork. For detailed guidance, visit our<a href=\"https://vescartes.com/pages/product-care?srsltid=AfmBOoqMkS6pd54hQGylf1UWwnXqowzxUxIjNTOhiBKVlA8S8Ts6kZ8d\"><span style=\"text-decoration:underline\"> Product Care page</span></a>.</p>"
          }
        }
      },
